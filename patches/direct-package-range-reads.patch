+// macRangeReadEntry is one file inside a test XAR archive.
+type macRangeReadEntry struct {
+	name  string
+	data  []byte
+	mtime string
+}
+
+// macRangeReadArchive builds a minimal XAR archive. The gomega fixtures
+// register a fail handler, so a plain test needs its own builder.
+func macRangeReadArchive(entries ...macRangeReadEntry) []byte {
+	var files string
+
+	offset := sha1.Size
+	heap := make([]byte, 0, 1024)
+
+	for index, entry := range entries {
+		checksum := sha1.Sum(entry.data) // #nosec G401 -- XAR uses SHA-1 for archive checksums.
+		files += fmt.Sprintf(`<file id="%d"><type>file</type><name>%s</name><mtime>%s</mtime><data><length>%d</length><offset>%d</offset><size>%d</size><encoding style="application/octet-stream"/><archived-checksum style="sha1">%x</archived-checksum><extracted-checksum style="sha1">%x</extracted-checksum></data></file>`,
+			index+1, entry.name, entry.mtime, len(entry.data), offset, len(entry.data), checksum, checksum)
+		offset += len(entry.data)
+		heap = append(heap, entry.data...)
+	}
+
+	toc := fmt.Sprintf(`<?xml version="1.0" encoding="UTF-8"?>
+<xar><toc><checksum style="sha1"><offset>0</offset><size>%d</size></checksum>%s</toc></xar>`, sha1.Size, files)
+
+	var compressed bytes.Buffer
+
+	writer := zlib.NewWriter(&compressed)
+	_, _ = writer.Write([]byte(toc))
+	_ = writer.Close()
+
+	compressedTOC := compressed.Bytes()
+	tocChecksum := sha1.Sum(compressedTOC) // #nosec G401 -- XAR uses SHA-1 for archive checksums.
+
+	archive := make([]byte, 28+len(compressedTOC)+sha1.Size+len(heap))
+	binary.BigEndian.PutUint32(archive[0:4], 0x78617221)
+	binary.BigEndian.PutUint16(archive[4:6], 28)
+	binary.BigEndian.PutUint16(archive[6:8], 1)
+	binary.BigEndian.PutUint64(archive[8:16], uint64(len(compressedTOC)))
+	binary.BigEndian.PutUint64(archive[16:24], uint64(len(toc)))
+	binary.BigEndian.PutUint32(archive[24:28], 1)
+	copy(archive[28:], compressedTOC)
+	copy(archive[28+len(compressedTOC):], tocChecksum[:])
+	copy(archive[28+len(compressedTOC)+sha1.Size:], heap)
+
+	return archive
+}
