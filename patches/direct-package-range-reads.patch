+}
+
+func TestVersionMetadataTraceAttribution(t *testing.T) {
+	trace := []store.StoreRequest{
+		{Seq: 1, Label: "lookup 892759993"},
+		{Seq: 2, Operation: "request", Method: gohttp.MethodPost, Endpoint: "downloaddispatch.test/ent/download", Pinned: "892759993", Status: 200, Ms: 800, Opens: 1, OpenMs: 100},
+		{Seq: 3, Label: "lookup 892829847"},
+		{Seq: 4, Operation: "request", Method: gohttp.MethodPost, Endpoint: "downloaddispatch.test/ent/download", Pinned: "892829847", Status: 200, Ms: 810, Opens: 1, OpenMs: 105},
+		{Seq: 5, Operation: packageReadOperation, Method: gohttp.MethodGet, Endpoint: "cdn.test/app.ipa", Pinned: "892759993", Status: 206, Ms: 1200, Range: "bytes=0-3", Bytes: 4},
+		{Seq: 6, Operation: "request", Method: gohttp.MethodPost, Endpoint: "downloaddispatch.test/ent/download", Pinned: "892829847", Status: 200, Ms: 795, Opens: 1, OpenMs: 99},
+	}
+
+	// The window holds six entries; the pin keeps the two that belong to it.
+	attributed := attributeTrace(trace, "892759993")
+	if len(attributed) != 2 {
+		t.Fatalf("attributed entries = %d, want 2", len(attributed))
+	}
+
+	opens, openMs := traceEmulatorTotals(attributed)
+	if opens != 1 || openMs != 100 {
+		t.Fatalf("attributed opens = %d, openMs = %d, want 1 and 100", opens, openMs)
+	}
+
+	counted := traceRequestTotals(attributed)
+	if counted["request POST downloaddispatch.test/ent/download"] != 1 {
+		t.Fatalf("request counts = %v", counted)
+	}
+
+	if counted["range-read GET cdn.test/app.ipa"] != 1 {
+		t.Fatalf("range read counts = %v", counted)
+	}
+
+	// Stages take time but are not requests: they are summed with the rest and
+	// stay out of the counts.
+	stages := []store.StoreRequest{
+		{Seq: 7, Operation: storeProofOperation, Pinned: "892759993", Ms: 4200},
+		{Seq: 8, Operation: storeBagOperation, Method: gohttp.MethodGet, Endpoint: "init.test/bag.xml", Pinned: "892759993", Ms: 150},
+	}
+
+	if total := traceTotalMs(stages); total != 4350 {
+		t.Fatalf("stage total = %d, want 4350", total)
+	}
+
+	if len(traceRequestTotals(stages)) != 1 {
+		t.Fatalf("stage request counts = %v", traceRequestTotals(stages))
+	}
+
+	// Without a pin there is nothing to attribute by, so the window is all there
+	// is; that is what the unpinned callers still use.
+	if len(attributeTrace(trace, "")) != len(trace) {
+		t.Fatal("an unpinned lookup must keep the whole window")
+	}
+}
+
+func newPackageReadTraceServer(payload []byte) *httptest.Server {
+	return httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, r *gohttp.Request) {
+		header := r.Header.Get("Range")
+
+		var start, stop int
+		if _, err := fmt.Sscanf(header, "bytes=%d-%d", &start, &stop); err != nil ||
+			start < 0 || stop >= len(payload) || start > stop {
+			w.WriteHeader(gohttp.StatusOK)
+			_, _ = w.Write(payload)
+
+			return
+		}
+
+		w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, stop, len(payload)))
+		w.WriteHeader(gohttp.StatusPartialContent)
+		_, _ = w.Write(payload[start : stop+1])
+	}))
+}
