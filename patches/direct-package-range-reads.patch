diff --git a/internal/store/backend_direct_test.go b/internal/store/backend_direct_test.go
new file mode 100644
index 0000000..5033acf
--- /dev/null
+++ b/internal/store/backend_direct_test.go
@@ -0,0 +1,166 @@
+package store
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/store/emulator"
+)
+
+// TestTransferDirectSkipsTheStoreEmulator pins the fast path for signed package
+// ranges. The backend has no machine identity here, so any request routed
+// through the emulator fails in hardware(); a 206 answer proves the direct
+// transport served it without a guest VM.
+func TestTransferDirectSkipsTheStoreEmulator(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if got := r.Header.Get("Range"); got != "bytes=0-0" {
+			t.Errorf("range header = %q, want bytes=0-0", got)
+		}
+
+		if got := r.Header.Get("User-Agent"); got == "" {
+			t.Error("user agent is empty")
+		}
+
+		w.Header().Set("Content-Range", "bytes 0-0/1024")
+		w.WriteHeader(http.StatusPartialContent)
+		_, _ = w.Write([]byte("x"))
+	}))
+	defer server.Close()
+
+	executor := New(nil, nil).Client("transfer-direct")
+
+	request, err := http.NewRequestWithContext(context.Background(), http.MethodGet, server.URL, nil)
+	if err != nil {
+		t.Fatalf("create request: %v", err)
+	}
+
+	request.Header.Set("Range", "bytes=0-0")
+	request.Header.Set("Accept-Encoding", "identity")
+
+	response, err := executor.Do(request)
+	if err != nil {
+		t.Fatalf("direct transfer: %v", err)
+	}
+
+	defer func() { _ = response.Body.Close() }()
+
+	if response.StatusCode != http.StatusPartialContent {
+		t.Fatalf("status = %d, want %d", response.StatusCode, http.StatusPartialContent)
+	}
+
+	if got := response.Header.Get("Content-Range"); got != "bytes 0-0/1024" {
+		t.Errorf("content range = %q, want bytes 0-0/1024", got)
+	}
+}
+
+// TestStoreRequestsCountPerEndpoint keeps the histogram that explains where a
+// slow lookup spends its requests: one counter per operation and endpoint, with
+// the query string stripped so signed URLs do not split the count.
+func TestStoreRequestsCountPerEndpoint(t *testing.T) {
+	backend := New(nil, nil)
+
+	backend.recordStoreRequest("request", "POST", "https://buy.itunes.apple.com/WebObjects/MZBuy.woa/wa/buyProduct?guid=abc")
+	backend.recordStoreRequest("request", "POST", "https://buy.itunes.apple.com/WebObjects/MZBuy.woa/wa/buyProduct?guid=def")
+	backend.recordStoreRequest("transfer", "GET", "https://iosapps-ssl.itunes.apple.com/subscription/1.ipa?sig=xyz")
+
+	counted := backend.StoreRequests()
+
+	if got := counted["request POST buy.itunes.apple.com/WebObjects/MZBuy.woa/wa/buyProduct"]; got != 2 {
+		t.Errorf("buyProduct count = %d, want 2", got)
+	}
+
+	if got := counted["transfer GET iosapps-ssl.itunes.apple.com/subscription/1.ipa"]; got != 1 {
+		t.Errorf("transfer count = %d, want 1", got)
+	}
+
+	if len(counted) != 2 {
+		t.Errorf("endpoints = %v, want two", counted)
+	}
+}
+
+// TestStoreTraceKeepsRequestsInOrder pins the trace that explains a slow
+// lookup: the order, the pinned build, the status and the time of each request,
+// plus the label that marks where a lookup starts.
+func TestStoreTraceKeepsRequestsInOrder(t *testing.T) {
+	backend := New(nil, nil)
+
+	backend.Mark("lookup 892759993")
+	backend.recordStoreTrace(
+		emulator.Request{
+			Operation:  "request",
+			Method:     http.MethodPost,
+			URL:        "https://p19-buy.itunes.apple.com/WebObjects/MZFinance.woa/wa/volumeStoreDownloadProduct?guid=ABCDEF",
+			Parameters: map[string]any{"appExtVrsId": "892759993"},
+		},
+		&http.Response{StatusCode: 200}, nil, 1400*time.Millisecond)
+	backend.recordStoreTrace(
+		emulator.Request{Operation: "request", Method: http.MethodPost, URL: "https://downloaddispatch.itunes.apple.com/r/redownload"},
+		nil, errors.New("download rejected"), 1500*time.Millisecond)
+
+	trace := backend.StoreTrace()
+	if len(trace) != 3 {
+		t.Fatalf("trace entries = %d, want 3", len(trace))
+	}
+
+	if trace[0].Label != "lookup 892759993" {
+		t.Errorf("label = %q, want the lookup mark", trace[0].Label)
+	}
+
+	if got := trace[1].Endpoint; got != "p19-buy.itunes.apple.com/WebObjects/MZFinance.woa/wa/volumeStoreDownloadProduct" {
+		t.Errorf("endpoint = %q, want the query string stripped", got)
+	}
+
+	if trace[1].Pinned != "892759993" {
+		t.Errorf("pinned build = %q, want 892759993", trace[1].Pinned)
+	}
+
+	if trace[1].Status != 200 || trace[1].Ms != 1400 {
+		t.Errorf("status = %d, ms = %d, want 200 and 1400", trace[1].Status, trace[1].Ms)
+	}
+
+	if trace[2].Status != 0 || !strings.Contains(trace[2].Error, "download rejected") {
+		t.Errorf("failed request = %+v, want the error recorded", trace[2])
+	}
+
+	if !(trace[0].Seq < trace[1].Seq && trace[1].Seq < trace[2].Seq) {
+		t.Errorf("sequence numbers are not increasing: %d, %d, %d", trace[0].Seq, trace[1].Seq, trace[2].Seq)
+	}
+}
+
+// TestStoreTraceIsBounded keeps the trace from growing with the session.
+func TestStoreTraceIsBounded(t *testing.T) {
+	backend := New(nil, nil)
+
+	for index := 0; index < storeTraceLimit+5; index++ {
+		backend.Mark(fmt.Sprintf("lookup %d", index))
+	}
+
+	trace := backend.StoreTrace()
+	if len(trace) != storeTraceLimit {
+		t.Fatalf("trace entries = %d, want %d", len(trace), storeTraceLimit)
+	}
+
+	if want := fmt.Sprintf("lookup %d", storeTraceLimit+4); trace[len(trace)-1].Label != want {
+		t.Errorf("last label = %q, want %q", trace[len(trace)-1].Label, want)
+	}
+}
+
+func TestRequestPinnedVersion(t *testing.T) {
+	if got := requestPinnedVersion(map[string]any{"appExtVrsId": "123"}); got != "123" {
+		t.Errorf("pinned build = %q, want 123", got)
+	}
+
+	if got := requestPinnedVersion(map[string]any{"externalVersionId": "456"}); got != "456" {
+		t.Errorf("pinned build = %q, want 456", got)
+	}
+
+	if got := requestPinnedVersion(map[string]any{"salableAdamId": int64(42)}); got != "" {
+		t.Errorf("pinned build = %q, want none", got)
+	}
+}
