-	reader, size, err := newHTTPRangeReaderAt(t.httpClient, url)
+	direct := directPackageReadClientFactory(t)
+	if direct == nil {
+		return versionMetadata{}, errors.New("package read client is not configured")
+	}
+
+	metadata, err := readVersionMetadataFromPackageURL(direct, url)
+	if err == nil {
+		metadata.PackageReadSource = packageReadSourceDirect
+
+		return metadata, nil
+	}
+
+	if !isPackageReadTransportError(err) {
+		metadata.PackageReadSource = packageReadSourceDirect
+		metadata.PackageReadError = err.Error()
+
+		return metadata, err
+	}
+
+	// Keep the emulated transfer client as a fallback: it is slow, but it is the
+	// path every earlier release used, so a CDN that rejects direct reads must
+	// not break version history.
+	fallback, fallbackErr := readVersionMetadataFromPackageURL(t.httpClient, url)
+	fallback.PackageReadSource = packageReadSourceEmulated
+	fallback.PackageReadError = fmt.Sprintf("direct read failed: %v", err)
+
+	if fallbackErr != nil {
+		fallback.PackageReadError = fmt.Sprintf("%s; emulated read failed: %v", fallback.PackageReadError, fallbackErr)
+	}
+
+	return fallback, fallbackErr
+}
