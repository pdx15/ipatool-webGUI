+// directPackageReadTransport is shared by direct package reads so the many range
+// requests one build needs reuse a single connection pool.
+var directPackageReadTransport = http.DefaultTransport.(*http.Transport).Clone()
+
+// directReadExecutor runs package range requests with a plain HTTP client. The
+// Store signs the package URL, so the CDN needs neither emulated headers nor a
+// guest VM, and opening one for every range request cost seconds per request.
+type directReadExecutor struct {
+	client *http.Client
+}
+
+func (e directReadExecutor) Send(apphttp.Request, []byte) (*http.Response, error) {
+	return nil, errors.New("package range reads only support direct requests")
+}
+
+func (e directReadExecutor) Do(request *http.Request) (*http.Response, error) {
+	if request.Header.Get("User-Agent") == "" {
+		request.Header.Set("User-Agent", apphttp.DefaultUserAgent)
+	}
+
+	return e.client.Do(request)
+}
+
+// directPackageReadClient reads packages without the Store emulator.
+func directPackageReadClient() apphttp.Client[interface{}] {
+	return apphttp.NewClient[interface{}](apphttp.Args{
+		Executor: directReadExecutor{client: &http.Client{Transport: directPackageReadTransport}},
+	})
+}
