+// EmulatorStats counts the Store framework launches and the time they took.
+// Every emulated request opens a guest VM, and that launch is the dominant cost
+// of a version history scan, so the counters explain where the time went.
+type EmulatorStats struct {
+	Opens  int64 `json:"opens"`
+	OpenMs int64 `json:"openMs"`
+}
+
+func (b *Backend) EmulatorStats() EmulatorStats {
+	return EmulatorStats{
+		Opens:  b.emulatorOpens.Load(),
+		OpenMs: b.emulatorOpenMs.Load(),
+	}
+}
+
+// StoreRequests counts the emulated Store requests per operation and endpoint,
+// so a slow lookup can be traced to the requests it actually sends.
+func (b *Backend) StoreRequests() map[string]int64 {
+	b.requestsMu.Lock()
+	defer b.requestsMu.Unlock()
+
+	counted := make(map[string]int64, len(b.requests))
+	for key, value := range b.requests {
+		counted[key] = value
+	}
+
+	return counted
+}
+
+func (b *Backend) recordStoreRequest(operation, method, rawURL string) {
+	key := operation + " " + method + " " + requestEndpoint(rawURL)
+
+	b.requestsMu.Lock()
+	defer b.requestsMu.Unlock()
+
+	if b.requests == nil {
+		b.requests = make(map[string]int64)
+	}
+
+	b.requests[key]++
+}
+
+// StoreRequest is one entry of the ordered emulator trace. A histogram says how
+// many requests a lookup sent; the order says why, which is what separates a
+// retried request from a second pass through the whole fallback chain.
+type StoreRequest struct {
+	Seq       int64  `json:"seq"`
+	Label     string `json:"label,omitempty"`
+	Operation string `json:"operation,omitempty"`
+	Method    string `json:"method,omitempty"`
+	Endpoint  string `json:"endpoint,omitempty"`
+	Pinned    string `json:"pinned,omitempty"`
+	Status    int    `json:"status,omitempty"`
+	Ms        int64  `json:"ms,omitempty"`
+	Error     string `json:"error,omitempty"`
+}
+
+// storeTraceLimit bounds the trace: it exists to explain one lookup, not to
+// grow with the session.
+const storeTraceLimit = 128
+
+// StoreTrace returns the recent requests in the order they were made.
+func (b *Backend) StoreTrace() []StoreRequest {
+	b.requestsMu.Lock()
+	defer b.requestsMu.Unlock()
+
+	trace := make([]StoreRequest, len(b.trace))
+	copy(trace, b.trace)
+
+	return trace
+}
+
+// Mark writes a label into the trace, so a reader can see where one lookup
+// starts and the next ends.
+func (b *Backend) Mark(label string) {
+	b.appendTrace(StoreRequest{Label: label})
+}
+
+func (b *Backend) appendTrace(entry StoreRequest) {
+	entry.Seq = b.traceSeq.Add(1)
+
+	b.requestsMu.Lock()
+	defer b.requestsMu.Unlock()
+
+	b.trace = append(b.trace, entry)
+	if len(b.trace) > storeTraceLimit {
+		b.trace = append([]StoreRequest(nil), b.trace[len(b.trace)-storeTraceLimit:]...)
+	}
+}
+
+// recordStoreTrace keeps the order, timing and outcome of one request.
+func (b *Backend) recordStoreTrace(input emulator.Request, response *http.Response, err error, elapsed time.Duration) {
+	entry := StoreRequest{
+		Operation: input.Operation,
+		Method:    input.Method,
+		Endpoint:  requestEndpoint(input.URL),
+		Pinned:    requestPinnedVersion(input.Parameters),
+		Ms:        elapsed.Milliseconds(),
+	}
+
+	if response != nil {
+		entry.Status = response.StatusCode
+	}
+
+	if err != nil {
+		entry.Error = truncateTraceValue(err.Error(), 120)
+	}
+
+	b.appendTrace(entry)
+}
+
+// requestPinnedVersion reports the build a request asked for, which separates a
+// pinned request from an unpinned one without keeping the whole payload.
+func requestPinnedVersion(parameters map[string]any) string {
+	for key, value := range parameters {
+		if !strings.Contains(strings.ToLower(key), "vrsid") && !strings.Contains(strings.ToLower(key), "versionid") {
+			continue
+		}
+
+		if pinned, ok := value.(string); ok {
+			return pinned
+		}
+	}
+
+	return ""
+}
+
+func truncateTraceValue(value string, limit int) string {
+	if len(value) <= limit {
+		return value
+	}
+
+	return value[:limit] + "..."
+}
+
+// requestEndpoint keeps the host and path so query strings and signatures do not
+// split one endpoint into dozens of counters.
+func requestEndpoint(rawURL string) string {
+	parsed, err := url.Parse(rawURL)
+	if err != nil || parsed.Host == "" {
+		return rawURL
+	}
+
+	return parsed.Host + parsed.Path
+}
+
+// recordEmulatorOpen accounts for one framework launch, successful or not.
+func (b *Backend) recordEmulatorOpen(elapsed time.Duration) {
+	b.emulatorOpens.Add(1)
+	b.emulatorOpenMs.Add(elapsed.Milliseconds())
