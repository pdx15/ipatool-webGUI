+		// can decrypt. Name the bytes that were served, so the response says
+		// which container it was.
+		var header [8]byte
+
+		read, _ := reader.ReadAt(header[:], 0)
+
+		return versionMetadata{}, fmt.Errorf("failed to parse XAR archive: %w (served bytes: % x)", err, header[:read])
+	}
+
 	if preflight {
-		return macPreflightVersionMetadata(&archive.Reader, bundleID)
+		return macPreflightVersionMetadata(archive, bundleID)
 	}
 
-	return macPackageVersionMetadata(&archive.Reader, bundleID)
+	return macPackageVersionMetadata(archive, bundleID)
 }
 
