+// directTransport serves signed package ranges on the shared pool, without the
+// Store emulator. It keeps the session cookies and follows the CDN redirects
+// that the emulated path handles inside the guest.
+func (b *Backend) directTransport(request *http.Request) (*http.Response, error) {
+	if request.Header.Get("User-Agent") == "" {
+		request.Header.Set("User-Agent", apphttp.DefaultUserAgent)
+	}
+
+	if b.jar != nil && request.Header.Get("Cookie") == "" {
+		for _, cookie := range b.jar.Cookies(request.URL) {
+			request.AddCookie(cookie)
+		}
+	}
+
+	response, err := (&http.Client{Transport: b.transport}).Do(request)
+	if err != nil {
+		return nil, fmt.Errorf("store HTTP transport: %w", err)
+	}
+
+	return response, nil
+}
