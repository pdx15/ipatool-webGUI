+// directPackageReadClientFactory builds the emulator-free range client. The
+// Store signs the package URL, so the CDN needs neither emulated headers nor a
+// guest VM, and opening one for every range request cost seconds per request.
+// The backend keeps the session cookies and the shared connection pool. Tests
+// replace the factory to exercise the emulated fallback.
+var directPackageReadClientFactory = func(t *appstore) apphttp.Client[interface{}] {
+	if t.authBackend == nil {
+		return t.httpClient
