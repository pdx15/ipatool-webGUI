diff --git a/internal/store/backend_trace_test.go b/internal/store/backend_trace_test.go
new file mode 100644
index 0000000..d20308e
--- /dev/null
+++ b/internal/store/backend_trace_test.go
@@ -0,0 +1,72 @@
+package store
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/store/emulator"
+)
+
+// TestRecordTraceKeepsExternalReads pins the entry a package read adds to the
+// same trace as the emulated requests. A lookup is only explainable when the
+// reads that never touched the emulator are in it.
+func TestRecordTraceKeepsExternalReads(t *testing.T) {
+	backend := New(nil, nil)
+
+	backend.RecordTrace(StoreRequest{
+		Operation: "range-read",
+		Method:    http.MethodGet,
+		Endpoint:  "cdn.example.test/app.ipa",
+		Pinned:    "892759993",
+		Status:    http.StatusPartialContent,
+		Ms:        42,
+		Range:     "bytes=0-3",
+		Bytes:     4,
+	})
+
+	trace := backend.StoreTrace()
+	if len(trace) != 1 {
+		t.Fatalf("trace entries = %d, want 1", len(trace))
+	}
+
+	entry := trace[0]
+	if entry.Operation != "range-read" || entry.Range != "bytes=0-3" || entry.Bytes != 4 {
+		t.Fatalf("trace entry = %+v", entry)
+	}
+
+	if entry.Seq == 0 {
+		t.Fatal("a recorded entry needs a sequence number")
+	}
+}
+
+// TestEmulatorOpenLandsOnTheRequestThatCausedIt pins the per-request launch
+// tally. The global counters cannot be split between concurrent lookups, so the
+// launch has to be recorded where the request that needed it can claim it.
+func TestEmulatorOpenLandsOnTheRequestThatCausedIt(t *testing.T) {
+	backend := New(nil, nil)
+
+	record := &openRecord{}
+	backend.recordEmulatorOpen(withOpenRecord(context.Background(), record), 90*time.Millisecond)
+	backend.recordEmulatorOpen(context.Background(), 10*time.Millisecond)
+
+	if record.opens != 1 || record.openMs != 90 {
+		t.Fatalf("request tally = %d opens, %d ms", record.opens, record.openMs)
+	}
+
+	stats := backend.EmulatorStats()
+	if stats.Opens != 2 || stats.OpenMs != 100 {
+		t.Fatalf("backend stats = %+v", stats)
+	}
+
+	entry := storeTraceEntry(emulator.Request{
+		Operation:  "request",
+		Method:     http.MethodPost,
+		URL:        "https://downloaddispatch.itunes.apple.com/WebObjects/DownloadDispatch.woa/wa/ent/download",
+		Parameters: map[string]any{"externalVersionId": "892759993"},
+	}, &http.Response{StatusCode: http.StatusOK}, nil, time.Second, *record)
+	if entry.Opens != 1 || entry.OpenMs != 90 {
+		t.Fatalf("trace entry = %+v", entry)
+	}
+}
