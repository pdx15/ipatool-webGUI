new file mode 100644
index 0000000..52515ce
--- /dev/null
+++ b/pkg/appstore/appstore_emulator_trace_test.go
@@ -0,0 +1,30 @@
+package appstore
+
+import (
+	"testing"
+
+	"github.com/majd/ipatool/v2/internal/store"
+)
+
+// TestStoreTraceSinceKeepsOnlyNewEntries pins the per-lookup window of the
+// shared trace: entries another lookup added must not leak into this response.
+func TestStoreTraceSinceKeepsOnlyNewEntries(t *testing.T) {
+	trace := []store.StoreRequest{{Seq: 1}, {Seq: 2}, {Seq: 4}}
+
+	added := storeTraceSince(trace, 1)
+	if len(added) != 2 || added[0].Seq != 2 || added[1].Seq != 4 {
+		t.Errorf("added entries = %+v, want sequences 2 and 4", added)
+	}
+
+	if added := storeTraceSince(trace, 4); added != nil {
+		t.Errorf("added entries = %+v, want none", added)
+	}
+
+	if got := traceSequence(trace); got != 4 {
+		t.Errorf("last sequence = %d, want 4", got)
+	}
+
+	if got := traceSequence(nil); got != 0 {
+		t.Errorf("empty last sequence = %d, want 0", got)
+	}
+}
