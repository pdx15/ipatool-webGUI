diff --git a/pkg/appstore/appstore_partial_zip_direct_test.go b/pkg/appstore/appstore_partial_zip_direct_test.go
new file mode 100644
index 0000000..86ae4fb
--- /dev/null
+++ b/pkg/appstore/appstore_partial_zip_direct_test.go
@@ -0,0 +1,242 @@
+package appstore
+
+import (
+	"archive/zip"
+	"bytes"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	apphttp "github.com/majd/ipatool/v2/pkg/http"
+)
+
+const directPackageReadInfoPlist = `<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+	<key>CFBundleShortVersionString</key>
+	<string>3.2.1</string>
+	<key>MinimumOSVersion</key>
+	<string>12.0</string>
+	<key>releaseDate</key>
+	<string>2026-10-09</string>
+</dict>
+</plist>
+`
+
+// directPackageReadArchive builds a minimal IPA so the range reader has a real
+// central directory and a real Payload/*.app/Info.plist to walk.
+func directPackageReadArchive(t *testing.T) []byte {
+	t.Helper()
+
+	buffer := new(bytes.Buffer)
+	writer := zip.NewWriter(buffer)
+	file, err := writer.Create("Payload/Demo.app/Info.plist")
+	if err != nil {
+		t.Fatalf("create Info.plist entry: %v", err)
+	}
+
+	if _, err = file.Write([]byte(directPackageReadInfoPlist)); err != nil {
+		t.Fatalf("write Info.plist entry: %v", err)
+	}
+
+	if err = writer.Close(); err != nil {
+		t.Fatalf("close IPA archive: %v", err)
+	}
+
+	return buffer.Bytes()
+}
+
+// servePackageRanges answers byte ranges the way the Store CDN does.
+func servePackageRanges(data []byte) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		spec, ranged := strings.CutPrefix(r.Header.Get("Range"), "bytes=")
+		if !ranged {
+			w.Header().Set("Content-Length", strconv.Itoa(len(data)))
+			_, _ = w.Write(data)
+
+			return
+		}
+
+		startText, endText, ok := strings.Cut(spec, "-")
+		if !ok {
+			w.WriteHeader(http.StatusRequestedRangeNotSatisfiable)
+
+			return
+		}
+
+		start, err := strconv.ParseInt(startText, 10, 64)
+		if err != nil || start < 0 || start >= int64(len(data)) {
+			w.WriteHeader(http.StatusRequestedRangeNotSatisfiable)
+
+			return
+		}
+
+		end := int64(len(data)) - 1
+		if endText != "" {
+			end, err = strconv.ParseInt(endText, 10, 64)
+			if err != nil || end < start {
+				w.WriteHeader(http.StatusRequestedRangeNotSatisfiable)
+
+				return
+			}
+		}
+
+		if end >= int64(len(data)) {
+			end = int64(len(data)) - 1
+		}
+
+		body := data[start : end+1]
+		w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, len(data)))
+		w.Header().Set("Content-Length", strconv.Itoa(len(body)))
+		w.WriteHeader(http.StatusPartialContent)
+		_, _ = w.Write(body)
+	}
+}
+
+// TestDirectPackageRangeReadReadsVersionMetadata pins the fast path for version
+// history: package ranges are read with a plain HTTP client, so no account, no
+// machine identity and no Unicorn guest are involved.
+func TestDirectPackageRangeReadReadsVersionMetadata(t *testing.T) {
+	server := httptest.NewServer(servePackageRanges(directPackageReadArchive(t)))
+	defer server.Close()
+
+	subject := &appstore{httpClient: newDownloadTestClient()}
+
+	metadata, err := subject.readVersionMetadataFromIPA(server.URL)
+	if err != nil {
+		t.Fatalf("read version metadata: %v", err)
+	}
+
+	if metadata.PackageReadSource != packageReadSourceDirect {
+		t.Errorf("package read source = %q, want %q", metadata.PackageReadSource, packageReadSourceDirect)
+	}
+
+	if metadata.PackageReadError != "" {
+		t.Errorf("package read error = %q, want no error", metadata.PackageReadError)
+	}
+
+	if metadata.DisplayVersion != "3.2.1" {
+		t.Errorf("display version = %q, want 3.2.1", metadata.DisplayVersion)
+	}
+
+	if metadata.MinimumOSVersion != "12.0" {
+		t.Errorf("minimum OS version = %q, want 12.0", metadata.MinimumOSVersion)
+	}
+
+	if releaseDate := metadata.ReleaseDate.Format("2006-01-02"); releaseDate != "2026-10-09" {
+		t.Errorf("release date = %q, want 2026-10-09", releaseDate)
+	}
+}
+
+// TestDirectPackageRangeReadSendsPlainHeaders guards the property that matters
+// for speed: direct reads carry only ordinary CDN headers. Store AMD headers in
+// this path would mean the emulator is back in the request path.
+func TestDirectPackageRangeReadSendsPlainHeaders(t *testing.T) {
+	var (
+		mu   sync.Mutex
+		seen []http.Header
+	)
+
+	handler := servePackageRanges(directPackageReadArchive(t))
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		seen = append(seen, r.Header.Clone())
+		mu.Unlock()
+
+		handler(w, r)
+	}))
+	defer server.Close()
+
+	if _, err := readVersionMetadataFromPackageURL(newDownloadTestClient(), server.URL); err != nil {
+		t.Fatalf("read version metadata: %v", err)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+
+	if len(seen) == 0 {
+		t.Fatal("no range requests reached the server")
+	}
+
+	for _, header := range seen {
+		if rangeHeader := header.Get("Range"); !strings.HasPrefix(rangeHeader, "bytes=") {
+			t.Errorf("range header = %q, want a byte range", rangeHeader)
+		}
+
+		if userAgent := header.Get("User-Agent"); userAgent == "" {
+			t.Error("user agent is empty")
+		}
+
+		for key := range header {
+			if strings.HasPrefix(key, "X-Apple-") {
+				t.Errorf("direct read sent Store header %q", key)
+			}
+		}
+	}
+}
+
+// TestPackageRangeReadFallsBackToTheStoreClient covers the CDN rejecting the
+// direct read: the emulated transfer client serves the build and the response
+// reports both the source and the direct failure.
+func TestPackageRangeReadFallsBackToTheStoreClient(t *testing.T) {
+	server := httptest.NewServer(servePackageRanges(directPackageReadArchive(t)))
+	defer server.Close()
+
+	dead := httptest.NewServer(servePackageRanges(directPackageReadArchive(t)))
+	dead.Close()
+
+	original := directPackageReadClientFactory
+	t.Cleanup(func() { directPackageReadClientFactory = original })
+
+	directPackageReadClientFactory = func(*appstore) apphttp.Client[interface{}] {
+		return newClientAt(dead.URL)
+	}
+
+	subject := &appstore{httpClient: newDownloadTestClient()}
+
+	metadata, err := subject.readVersionMetadataFromIPA(server.URL)
+	if err != nil {
+		t.Fatalf("read version metadata: %v", err)
+	}
+
+	if metadata.DisplayVersion != "3.2.1" {
+		t.Errorf("display version = %q, want 3.2.1", metadata.DisplayVersion)
+	}
+
+	if metadata.PackageReadSource != packageReadSourceEmulated {
+		t.Errorf("package read source = %q, want %q", metadata.PackageReadSource, packageReadSourceEmulated)
+	}
+
+	if !strings.Contains(metadata.PackageReadError, "direct read failed") {
+		t.Errorf("package read error = %q, want the direct failure", metadata.PackageReadError)
+	}
+}
+
+// newClientAt builds a direct read client bound to a fixed base URL, so a test
+// can point the direct attempt at a server that is known to be unreachable.
+func newClientAt(baseURL string) apphttp.Client[interface{}] {
+	return apphttp.NewClient[interface{}](apphttp.Args{Executor: baseURLExecutor{baseURL: baseURL}})
+}
+
+type baseURLExecutor struct {
+	baseURL string
+}
+
+func (e baseURLExecutor) Send(apphttp.Request, []byte) (*http.Response, error) {
+	return nil, errors.New("package range reads only support direct requests")
+}
+
+func (e baseURLExecutor) Do(request *http.Request) (*http.Response, error) {
+	// The caller builds a request from the live server URL; rewrite it to the
+	// closed one so the direct attempt fails at the transport level.
+	request.URL.Scheme = "http"
+	request.URL.Host = strings.TrimPrefix(e.baseURL, "http://")
+
+	return http.DefaultClient.Do(request)
+}
