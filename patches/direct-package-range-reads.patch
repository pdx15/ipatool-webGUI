+	copy(archive[28:], compressedTOC)
+	copy(archive[28+len(compressedTOC):], tocChecksum[:])
+	copy(archive[28+len(compressedTOC)+sha1.Size:], heap)
+
+	return archive
+}
+
+func macRangeReadPackageXAR(info string) []byte {
+	return macRangeReadArchive(
+		macRangeReadEntry{name: "PackageInfo", data: []byte(info), mtime: macRangeReadModified},
+		macRangeReadEntry{name: "Payload", data: []byte("app payload"), mtime: macRangeReadModified},
+	)
+}
+
+func macRangeReadPreflightXAR(distribution string) []byte {
+	return macRangeReadArchive(macRangeReadEntry{name: "Distribution", data: []byte(distribution)})
+}
+
+const macRangeReadDistribution = `<installer-gui-script><product id="com.example.mac" version="4.2"/>
+<pkg-ref id="com.example.pkg"><relocate><bundle id="com.example.mac"/></relocate></pkg-ref>
+<pkg-ref id="com.example.pkg" version="4.2.0.0.1.1341568473"/></installer-gui-script>`
+
+// macRangeReadModernDistribution mirrors a current Mac installer: the build
+// timestamp is not part of the package version anymore.
+const macRangeReadModernDistribution = `<installer-gui-script><product id="com.example.mac" version="11.15"/>
+<pkg-ref id="com.example.pkg" version="11.15.0"><relocate><bundle id="com.example.mac"/></relocate></pkg-ref>
+<volume-check><allowed-os-versions><os-version min="10.13"/></allowed-os-versions></volume-check></installer-gui-script>`
+
+// TestMacPackageRangeReadReadsMetadataWithoutTheStoreAgent pins the fast path:
+// the XAR table of contents and PackageInfo come out of ranged requests, so no
+// installer is downloaded and the Store agent never decrypts one.
+func TestMacPackageRangeReadReadsMetadataWithoutTheStoreAgent(t *testing.T) {
+	data := macRangeReadPackageXAR(macRangeReadInfo)
+
+	requests := 0
+
+	server := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, r *gohttp.Request) {
+		requests++
+
+		if r.Header.Get("Range") == "" {
+			t.Errorf("request %d has no range header", requests)
+		}
+
+		gohttp.ServeContent(w, r, "app.pkg", time.Time{}, bytes.NewReader(data))
+	}))
+	defer server.Close()
+
+	store := &appstore{httpClient: newDownloadTestClient()}
+
+	metadata, err := store.readMacPackageMetadataFromRanges(server.URL, false, "com.example.mac", "")
+	if err != nil {
+		t.Fatalf("ranged read: %v", err)
+	}
+
+	if metadata.DisplayVersion != "1.2.1" {
+		t.Errorf("display version = %q, want 1.2.1", metadata.DisplayVersion)
+	}
+
+	want := time.Date(2025, 7, 24, 8, 38, 42, 0, time.UTC)
+	if !metadata.ReleaseDate.Equal(want) {
+		t.Errorf("release date = %s, want %s", metadata.ReleaseDate, want)
+	}
+
+	if metadata.PackageReadSource != packageReadSourceDirect {
+		t.Errorf("package read source = %q, want %q", metadata.PackageReadSource, packageReadSourceDirect)
+	}
+
+	if metadata.PackageReadError != "" {
+		t.Errorf("package read error = %q, want none", metadata.PackageReadError)
+	}
+
+	if requests == 0 {
+		t.Fatal("the ranged read made no requests")
+	}
+}
+
+// TestMacPackageRangeReadReportsACDNThatIgnoresRanges keeps the reason for the
+// fallback, so a slow history can be told apart from a package that has to be
+// downloaded.
+func TestMacPackageRangeReadReportsACDNThatIgnoresRanges(t *testing.T) {
+	data := macRangeReadPackageXAR(macRangeReadInfo)
+
+	server := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, _ *gohttp.Request) {
+		_, _ = w.Write(data)
+	}))
+	defer server.Close()
+
+	store := &appstore{httpClient: newDownloadTestClient()}
+
+	_, err := store.readMacPackageMetadataFromRanges(server.URL, false, "com.example.mac", "")
+	if err == nil {
+		t.Fatal("expected the ranged read to fail")
+	}
+
+	if !strings.Contains(err.Error(), "expected partial content response") {
+		t.Errorf("error = %v, want a range rejection", err)
+	}
+}
+
+// TestMacPackageMetadataReportsTheFullDownloadFallback covers the last resort:
+// the installer is downloaded and decrypted, and the response says so together
+// with the reason the ranged read did not work.
+func TestMacPackageMetadataReportsTheFullDownloadFallback(t *testing.T) {
+	tempRoot := t.TempDir()
+	t.Setenv("TMPDIR", tempRoot)
+	t.Setenv("TMP", tempRoot)
+	t.Setenv("TEMP", tempRoot)
+
+	data := macRangeReadPackageXAR(macRangeReadInfo)
+
+	server := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, _ *gohttp.Request) {
+		_, _ = w.Write([]byte("encrypted"))
+	}))
+	defer server.Close()
+
+	store := &appstore{
+		httpClient: newDownloadTestClient(),
+		os:         operatingsystem.New(),
+		macDecrypterFactory: func(context.Context, []byte, []byte) (macPackageDecrypter, error) {
+			return &fakeMacPackageDecrypter{output: data}, nil
+		},
+	}
+
+	item := downloadItemResult{
+		URL:      server.URL,
+		Sinfs:    []Sinf{{DPInfo: []byte("dpInfo")}},
+		Metadata: map[string]interface{}{"softwareVersionBundleId": "com.example.mac"},
+	}
+
+	metadata, err := store.readVersionMetadataFromMacPackage(context.Background(), item, []byte{0, 17, 34, 51, 68, 85}, "com.example.mac", "")
+	if err != nil {
+		t.Fatalf("macOS version metadata: %v", err)
+	}
+
+	if metadata.DisplayVersion != "1.2.1" {
+		t.Errorf("display version = %q, want 1.2.1", metadata.DisplayVersion)
+	}
+
+	if metadata.PackageReadSource != packageReadSourceFullDownload {
+		t.Errorf("package read source = %q, want %q", metadata.PackageReadSource, packageReadSourceFullDownload)
+	}
+
+	if !strings.Contains(metadata.PackageReadError, "expected partial content response") {
+		t.Errorf("package read error = %q, want the range rejection", metadata.PackageReadError)
+	}
+}
+
+// TestMacPackageMetadataPrefersThePreflightArchive covers the response Apple
+// actually sends: the installer is wrapped in a container that cannot be parsed
+// from its bytes, while the preflight archive carries the same build metadata
+// without the payload.
+func TestMacPackageMetadataPrefersThePreflightArchive(t *testing.T) {
+	preflight := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, r *gohttp.Request) {
+		gohttp.ServeContent(w, r, "preflight.pkg", time.Time{}, bytes.NewReader(macRangeReadPreflightXAR(macRangeReadDistribution)))
+	}))
+	defer preflight.Close()
+
+	installer := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, _ *gohttp.Request) {
+		t.Error("the installer package must not be requested when the preflight archive answers")
+	}))
+	defer installer.Close()
+
+	store := &appstore{httpClient: newDownloadTestClient(), os: operatingsystem.New()}
+
+	item := downloadItemResult{
+		URL:                 installer.URL,
+		PreflightPackageURL: preflight.URL,
+		Sinfs:               []Sinf{{DPInfo: []byte("dpInfo")}},
+		Metadata:            map[string]interface{}{"softwareVersionBundleId": "com.example.mac"},
+	}
+
+	metadata, err := store.readVersionMetadataFromMacPackage(context.Background(), item, []byte{0, 17, 34, 51, 68, 85}, "com.example.mac", "")
+	if err != nil {
+		t.Fatalf("macOS version metadata: %v", err)
+	}
+
+	if metadata.DisplayVersion != "4.2" {
+		t.Errorf("display version = %q, want 4.2", metadata.DisplayVersion)
+	}
+
+	if metadata.PackageReadSource != packageReadSourceDirect {
+		t.Errorf("package read source = %q, want %q", metadata.PackageReadSource, packageReadSourceDirect)
+	}
+}
+
+// TestMacPackageMetadataDownloadsThePreflightArchive keeps the payload-free
+// archive reachable when it cannot be ranged: it still needs no decryption and
+// no multi-hundred-megabyte download.
+func TestMacPackageMetadataDownloadsThePreflightArchive(t *testing.T) {
+	tempRoot := t.TempDir()
+	t.Setenv("TMPDIR", tempRoot)
+	t.Setenv("TMP", tempRoot)
+	t.Setenv("TEMP", tempRoot)
+
+	data := macRangeReadPreflightXAR(macRangeReadDistribution)
+
+	preflight := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, _ *gohttp.Request) {
+		_, _ = w.Write(data)
+	}))
+	defer preflight.Close()
+
+	// The installer is still probed for a XAR header, but any attempt to
+	// download it would reach the decrypter below and fail the whole read.
+	installer := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, _ *gohttp.Request) {
+		_, _ = w.Write([]byte("container"))
+	}))
+	defer installer.Close()
+
+	store := &appstore{
+		httpClient: newDownloadTestClient(),
+		os:         operatingsystem.New(),
+		macDecrypterFactory: func(context.Context, []byte, []byte) (macPackageDecrypter, error) {
+			return &fakeMacPackageDecrypter{err: errors.New("the preflight archive must not be decrypted")}, nil
+		},
+	}
+
+	item := downloadItemResult{
+		URL:                 installer.URL,
+		PreflightPackageURL: preflight.URL,
+		Sinfs:               []Sinf{{DPInfo: []byte("dpInfo")}},
+		Metadata:            map[string]interface{}{"softwareVersionBundleId": "com.example.mac"},
+	}
+
+	metadata, err := store.readVersionMetadataFromMacPackage(context.Background(), item, []byte{0, 17, 34, 51, 68, 85}, "com.example.mac", "")
+	if err != nil {
+		t.Fatalf("macOS version metadata: %v", err)
+	}
+
+	if metadata.DisplayVersion != "4.2" {
+		t.Errorf("display version = %q, want 4.2", metadata.DisplayVersion)
+	}
+
+	if metadata.PackageReadSource != packageReadSourcePreflight {
+		t.Errorf("package read source = %q, want %q", metadata.PackageReadSource, packageReadSourcePreflight)
+	}
+
+	if !strings.Contains(metadata.PackageReadError, "expected partial content response") {
+		t.Errorf("package read error = %q, want the range rejection", metadata.PackageReadError)
+	}
+}
+
+// TestMacPackageRangeReadReportsTheServedContainer records what the Store
+// actually serves, so an unparsable package names its container instead of
+// failing quietly.
+func TestMacPackageRangeReadReportsTheServedContainer(t *testing.T) {
+	// An MP4-style container, which is what a FairPlay-wrapped asset starts with.
+	data := append([]byte{0x00, 0x00, 0x00, 0x1c}, []byte("ftypM4A ")...)
+
+	server := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, r *gohttp.Request) {
+		gohttp.ServeContent(w, r, "app.pkg", time.Time{}, bytes.NewReader(data))
+	}))
+	defer server.Close()
+
+	store := &appstore{httpClient: newDownloadTestClient()}
+
+	_, err := store.readMacPackageMetadataFromRanges(server.URL, false, "com.example.mac", "")
+	if err == nil {
+		t.Fatal("expected the ranged read to fail")
+	}
+
+	if !strings.Contains(err.Error(), "served bytes: 00 00 00 1c 66 74 79 70") {
+		t.Errorf("error = %v, want the served container header", err)
+	}
+}
+
+// TestMacPackageMetadataReadsTheBuildDateFromTheArchive covers the data the
+// Store actually ships: the build date is not in the package version, but the
+// archive table of contents carries it as the Payload mtime.
+func TestMacPackageMetadataReadsTheBuildDateFromTheArchive(t *testing.T) {
+	const built = "2026-10-20T19:29:36Z"
+
+	data := macRangeReadArchive(
+		macRangeReadEntry{name: "Distribution", data: []byte(macRangeReadModernDistribution)},
+		macRangeReadEntry{name: "Payload", data: []byte("payload"), mtime: built},
+	)
+
+	server := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, r *gohttp.Request) {
+		gohttp.ServeContent(w, r, "preflight.pkg", time.Time{}, bytes.NewReader(data))
+	}))
+	defer server.Close()
+
+	store := &appstore{httpClient: newDownloadTestClient()}
+
+	metadata, err := store.readMacPackageMetadataFromRanges(server.URL, true, "com.example.mac", "")
+	if err != nil {
+		t.Fatalf("ranged preflight read: %v", err)
+	}
+
+	if metadata.DisplayVersion != "11.15" {
+		t.Errorf("display version = %q, want 11.15", metadata.DisplayVersion)
+	}
+
+	want := time.Date(2026, 10, 20, 19, 29, 36, 0, time.UTC)
+	if !metadata.ReleaseDate.Equal(want) {
+		t.Errorf("release date = %s, want %s", metadata.ReleaseDate, want)
+	}
+
+	if metadata.MinimumOSVersion != "10.13" {
+		t.Errorf("minimum OS version = %q, want 10.13", metadata.MinimumOSVersion)
+	}
+
+	if metadata.PackageReadError != "" {
+		t.Errorf("package read error = %q, want none", metadata.PackageReadError)
+	}
+}
+
+// TestMacPackageMetadataKeepsTheVersionWithoutABuildDate keeps the fast path
+// useful even when the archive carries no timestamp at all: the version is the
+// expensive part, and the missing date is explained instead of hidden.
+func TestMacPackageMetadataKeepsTheVersionWithoutABuildDate(t *testing.T) {
+	data := macRangeReadArchive(macRangeReadEntry{name: "Distribution", data: []byte(macRangeReadModernDistribution)})
+
+	server := httptest.NewServer(gohttp.HandlerFunc(func(w gohttp.ResponseWriter, r *gohttp.Request) {
+		gohttp.ServeContent(w, r, "preflight.pkg", time.Time{}, bytes.NewReader(data))
+	}))
+	defer server.Close()
+
+	store := &appstore{httpClient: newDownloadTestClient()}
+
+	metadata, err := store.readMacPackageMetadataFromRanges(server.URL, true, "com.example.mac", "")
+	if err != nil {
+		t.Fatalf("ranged preflight read: %v", err)
+	}
+
+	if metadata.DisplayVersion != "11.15" {
+		t.Errorf("display version = %q, want 11.15", metadata.DisplayVersion)
+	}
+
+	if !metadata.ReleaseDate.IsZero() {
+		t.Errorf("release date = %s, want none", metadata.ReleaseDate)
+	}
+
+	if !strings.Contains(metadata.PackageReadError, "no build timestamp") {
+		t.Errorf("package read error = %q, want the missing timestamp", metadata.PackageReadError)
+	}
+}
+
+// TestMacPackageMetadataReadsTheDateFromTheTableOfContents covers the preflight
+// archive: its Distribution entry carries no mtime, so the creation-time of the
+// table of contents is the only timestamp left.
+func TestMacPackageMetadataReadsTheDateFromTheTableOfContents(t *testing.T) {
+	archive := macRangeReadArchiveAt("2026-10-20T19:29:36",
+		macRangeReadEntry{name: "Distribution", data: []byte(macRangeReadModernDistribution)})
+
+	reader, err := xar.NewReader(bytes.NewReader(archive), int64(len(archive)))
+	if err != nil {
+		t.Fatalf("failed to open fixture archive: %v", err)
+	}
+
+	metadata, err := macPreflightVersionMetadata(reader, "com.example.mac")
+	if err != nil {
+		t.Fatalf("preflight metadata failed: %v", err)
+	}
+
+	want := time.Date(2026, 10, 20, 19, 29, 36, 0, time.UTC)
+	if !metadata.ReleaseDate.Equal(want) {
+		t.Errorf("release date = %v, want %v", metadata.ReleaseDate, want)
+	}
+
+	if metadata.PackageReadError != "" {
+		t.Errorf("package read error = %q, want none", metadata.PackageReadError)
+	}
+
+	if metadata.DisplayVersion != "11.15" {
+		t.Errorf("display version = %q, want 11.15", metadata.DisplayVersion)
+	}
+
+	if metadata.MinimumOSVersion != "10.13" {
+		t.Errorf("minimum OS version = %q, want 10.13", metadata.MinimumOSVersion)
+	}
+}
diff --git a/pkg/appstore/appstore_package_read_trace.go b/pkg/appstore/appstore_package_read_trace.go
new file mode 100644
index 0000000..9f16a51
--- /dev/null
+++ b/pkg/appstore/appstore_package_read_trace.go
@@ -0,0 +1,158 @@
+package appstore
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sync"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/store"
+	apphttp "github.com/majd/ipatool/v2/pkg/http"
+)
+
+// packageReadOperation marks a ranged package read in the trace, next to the
+// emulated Store requests that the same lookup sent.
+const packageReadOperation = "range-read"
+
+// packageReadRecorder records one ranged package read. A nil recorder disables
+// tracing, which is what the CLI and the tests use.
+type packageReadRecorder func(entry store.StoreRequest)
+
+// packageReadRecorder returns a recorder for one lookup, or nil when there is no
+// backend to record into. Every read of a pinned lookup carries the build it
+// asked for, so the recorder stamps the pin and the trace can be attributed to
+// that lookup alone.
+func (t *appstore) packageReadRecorder(pinned string) packageReadRecorder {
+	backend := t.authBackend
+	if backend == nil {
+		return nil
+	}
+
+	return func(entry store.StoreRequest) {
+		entry.Operation = packageReadOperation
+		entry.Pinned = pinned
+		backend.RecordTrace(entry)
+	}
+}
+
+// withPackageReadRecorder wraps a client so every ranged read it serves lands in
+// the trace with its window, its status, the bytes that arrived and the time it
+// took. The package read is otherwise invisible: it never touches the emulator,
+// so neither the counters nor the request trace see it.
+func withPackageReadRecorder(client apphttp.Client[interface{}], record packageReadRecorder) apphttp.Client[interface{}] {
+	if client == nil || record == nil {
+		return client
+	}
+
+	return tracedPackageClient{inner: client, record: record}
+}
+
+type tracedPackageClient struct {
+	inner  apphttp.Client[interface{}]
+	record packageReadRecorder
+}
+
+func (c tracedPackageClient) Send(request apphttp.Request) (apphttp.Result[interface{}], error) {
+	return c.inner.Send(request)
+}
+
+func (c tracedPackageClient) NewRequest(method, rawURL string, body io.Reader) (*http.Request, error) {
+	return c.inner.NewRequest(method, rawURL, body)
+}
+
+func (c tracedPackageClient) Do(request *http.Request) (*http.Response, error) {
+	started := time.Now()
+	window := request.Header.Get("Range")
+
+	response, err := c.inner.Do(request)
+	if response == nil || response.Body == nil {
+		c.recordRead(request, window, statusCode(response), 0, time.Since(started), err)
+
+		return response, err
+	}
+
+	// The window is only useful with the bytes that arrived, so the entry is
+	// written when the body is closed: until then the read is still running.
+	response.Body = &tracedPackageBody{
+		inner: response.Body,
+		record: func(read int64) {
+			c.recordRead(request, window, response.StatusCode, read, time.Since(started), nil)
+		},
+	}
+
+	return response, err
+}
+
+func (c tracedPackageClient) recordRead(request *http.Request, window string, status int, read int64, elapsed time.Duration, err error) {
+	entry := store.StoreRequest{
+		Method:   request.Method,
+		Endpoint: packageReadEndpoint(request.URL),
+		Status:   status,
+		Ms:       elapsed.Milliseconds(),
+		Range:    window,
+		Bytes:    read,
+	}
+
+	if err != nil {
+		entry.Error = truncateTraceError(err)
+	}
+
+	c.record(entry)
+}
+
+// tracedPackageBody counts the bytes of a read and reports them once, when the
+// caller closes the body.
+type tracedPackageBody struct {
+	inner  io.ReadCloser
+	record func(read int64)
+
+	mu     sync.Mutex
+	read   int64
+	closed bool
+}
+
+func (b *tracedPackageBody) Read(p []byte) (int, error) {
+	n, err := b.inner.Read(p)
+
+	b.mu.Lock()
+	b.read += int64(n)
+	b.mu.Unlock()
+
+	return n, err
+}
+
+func (b *tracedPackageBody) Close() error {
+	err := b.inner.Close()
+
+	b.mu.Lock()
+	read := b.read
+	first := !b.closed
+	b.closed = true
+	b.mu.Unlock()
+
+	if first {
+		b.record(read)
+	}
+
+	return err
+}
+
+func statusCode(response *http.Response) int {
+	if response == nil {
+		return 0
+	}
+
+	return response.StatusCode
+}
+
+// packageReadEndpoint keeps the host and path of a package read, so a CDN that
+// signs every URL does not split one endpoint into hundreds of entries.
+func packageReadEndpoint(rawURL *url.URL) string {
+	if rawURL == nil || rawURL.Host == "" {
+		return ""
+	}
+
+	return rawURL.Host + rawURL.Path
+}
diff --git a/pkg/appstore/appstore_package_read_trace_test.go b/pkg/appstore/appstore_package_read_trace_test.go
new file mode 100644
index 0000000..79a617c
--- /dev/null
+++ b/pkg/appstore/appstore_package_read_trace_test.go
@@ -0,0 +1,160 @@
+package appstore
+
+import (
+	"fmt"
+	gohttp "net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/majd/ipatool/v2/internal/store"
+)
+
+// The ranged package read is the blind spot of a lookup: it never touches the
+// emulator, so neither the counters nor the request trace see it. These tests
+// pin the two things that make it visible: every read is recorded with its
+// window, status, bytes and time, and every entry carries the build the lookup
+// asked for, so the trace can be attributed to one lookup.
+func TestPackageReadRecorderRecordsRanges(t *testing.T) {
+	server := newPackageReadTraceServer([]byte("0123456789abcdef"))
+	defer server.Close()
+
+	var recorded []store.StoreRequest
+
+	client := withPackageReadRecorder(newDownloadTestClient(), func(entry store.StoreRequest) {
+		recorded = append(recorded, entry)
+	})
+
+	reader, size, err := newHTTPRangeReaderAt(client, server.URL)
+	if err != nil {
+		t.Fatalf("newHTTPRangeReaderAt() error = %v", err)
+	}
+
+	if size != 16 {
+		t.Fatalf("remote size = %d, want 16", size)
+	}
+
+	if _, err := reader.ReadAt(make([]byte, 4), 0); err != nil {
+		t.Fatalf("ReadAt() error = %v", err)
+	}
+
+	if len(recorded) < 2 {
+		t.Fatalf("recorded %d reads, want the size probe and the ranged read", len(recorded))
+	}
+
+	probe := recorded[0]
+	if probe.Method != gohttp.MethodGet || probe.Status != gohttp.StatusPartialContent {
+		t.Fatalf("size probe = %+v", probe)
+	}
+
+	// The size probe asks for one byte and never reads the body, so it reports
+	// the window it asked for and no bytes.
+	if probe.Range != "bytes=0-0" || probe.Bytes != 0 {
+		t.Fatalf("size probe range = %q, bytes = %d", probe.Range, probe.Bytes)
+	}
+
+	if !strings.HasPrefix(probe.Endpoint, strings.TrimPrefix(server.URL, "http://")) {
+		t.Fatalf("size probe endpoint = %q", probe.Endpoint)
+	}
+
+	// The read-ahead window is clamped to the sixteen bytes the server holds, and
+	// the entry reports the bytes that actually arrived.
+	window := recorded[1]
+	if window.Range != "bytes=0-15" || window.Bytes != 16 {
+		t.Fatalf("ranged read range = %q, bytes = %d", window.Range, window.Bytes)
+	}
+}
+
+func TestPackageReadRecorderStampsTheLookupPin(t *testing.T) {
+	backend := store.New(nil, nil)
+	subject := &appstore{authBackend: backend}
+
+	subject.packageReadRecorder("892759993")(store.StoreRequest{
+		Method:   gohttp.MethodGet,
+		Endpoint: "cdn.example.test/app.ipa",
+		Status:   gohttp.StatusPartialContent,
+		Ms:       1200,
+		Range:    "bytes=0-3",
+		Bytes:    4,
+	})
+
+	trace := backend.StoreTrace()
