+// isPackageReadTransportError reports whether the direct read failed before the
+// zip was parsed. Only then can the emulated transfer client help.
+func isPackageReadTransportError(err error) bool {
+	if err == nil {
+		return false
+	}
+
+	message := err.Error()
+
+	return strings.Contains(message, "failed to read remote file size") ||
+		strings.Contains(message, "expected partial content response") ||
+		strings.Contains(message, "request failed") ||
+		strings.Contains(message, "failed to read response body") ||
+		strings.Contains(message, "unexpected content range")
+}
