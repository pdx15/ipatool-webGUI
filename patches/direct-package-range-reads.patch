+// versionMetadataOutput copies a package read result into the public output.
+// The output also carries the emulator counters, which the read itself cannot
+// know, so the two structs are no longer the same type.
+func versionMetadataOutput(metadata versionMetadata) GetVersionMetadataOutput {
+	return GetVersionMetadataOutput{
+		DisplayVersion:    metadata.DisplayVersion,
+		ReleaseDate:       metadata.ReleaseDate,
+		MinimumOSVersion:  metadata.MinimumOSVersion,
+		PackageReadSource: metadata.PackageReadSource,
+		PackageReadError:  metadata.PackageReadError,
+	}
+}
+
+// emulatorSnapshot captures the backend counters before a lookup runs. Without
+// a backend every request uses the regular client, so the counters stay empty.
+func (t *appstore) emulatorSnapshot() emulatorSnapshot {
+	if t.authBackend == nil {
+		return emulatorSnapshot{}
+	}
+
+	return emulatorSnapshot{
+		stats:    t.authBackend.EmulatorStats(),
+		requests: t.authBackend.StoreRequests(),
+		trace:    t.authBackend.StoreTrace(),
+	}
+}
+
+type emulatorSnapshot struct {
+	stats    store.EmulatorStats
+	requests map[string]int64
+	trace    []store.StoreRequest
+}
+
+// withEmulatorStats narrows the backend counters to this lookup. A pinned
+// lookup is attributed by the build it asked for: every request it sends carries
+// that pin, while the global counters and a time window both capture the four
+// lookups that run beside it.
+func (t *appstore) withEmulatorStats(output GetVersionMetadataOutput, before emulatorSnapshot, pinned string) GetVersionMetadataOutput {
+	after := t.emulatorSnapshot()
+
+	output.EmulatorTrace = attributeTrace(storeTraceSince(after.trace, traceSequence(before.trace)), pinned)
+	output.TracedMs = traceTotalMs(output.EmulatorTrace)
+
+	if pinned != "" {
+		output.EmulatorOpens, output.EmulatorOpenMs = traceEmulatorTotals(output.EmulatorTrace)
+		output.EmulatorRequests = traceRequestTotals(output.EmulatorTrace)
+
+		return output
+	}
+
+	output.EmulatorOpens = after.stats.Opens - before.stats.Opens
+	output.EmulatorOpenMs = after.stats.OpenMs - before.stats.OpenMs
+	output.EmulatorRequests = requestCountDelta(before.requests, after.requests)
+
+	return output
+}
+
+// attributeTrace keeps the entries a pinned lookup made. Requests made without a
+// pin cannot be told apart from another lookup's, so they are left out.
+func attributeTrace(trace []store.StoreRequest, pinned string) []store.StoreRequest {
+	if pinned == "" {
+		return trace
+	}
+
+	kept := make([]store.StoreRequest, 0, len(trace))
+	for _, entry := range trace {
+		if entry.Pinned == pinned {
+			kept = append(kept, entry)
+		}
+	}
+
+	return kept
+}
+
+// traceTotalMs sums the time the traced entries took.
+func traceTotalMs(trace []store.StoreRequest) int64 {
+	var total int64
+
+	for _, entry := range trace {
+		total += entry.Ms
+	}
+
+	return total
+}
+
+// traceEmulatorTotals sums the framework launches the traced requests needed.
+func traceEmulatorTotals(trace []store.StoreRequest) (int64, int64) {
+	var opens, openMs int64
+
+	for _, entry := range trace {
+		opens += entry.Opens
+		openMs += entry.OpenMs
+	}
+
+	return opens, openMs
+}
+
+// traceRequestTotals counts traced requests by operation, method and endpoint,
+// the same key the backend histogram uses.
+func traceRequestTotals(trace []store.StoreRequest) map[string]int64 {
+	counted := make(map[string]int64, len(trace))
+
+	for _, entry := range trace {
+		if entry.Operation == "" || entry.Endpoint == "" {
+			continue
+		}
+
+		counted[entry.Operation+" "+entry.Method+" "+entry.Endpoint]++
+	}
+
+	return counted
+}
+
+// traceSequence reports the last sequence number in a snapshot.
+func traceSequence(trace []store.StoreRequest) int64 {
+	if len(trace) == 0 {
+		return 0
+	}
+
+	return trace[len(trace)-1].Seq
+}
+
+// storeTraceSince keeps the entries this lookup added.
+func storeTraceSince(trace []store.StoreRequest, after int64) []store.StoreRequest {
+	if len(trace) == 0 {
+		return nil
+	}
+
+	added := make([]store.StoreRequest, 0, len(trace))
+
+	for _, entry := range trace {
+		if entry.Seq > after {
+			added = append(added, entry)
+		}
+	}
+
+	if len(added) == 0 {
+		return nil
+	}
+
+	return added
+}
+
+// markStoreTrace labels a point in the emulator trace. Without a backend there
+// is nothing to trace.
+func (t *appstore) markStoreTrace(label string) {
+	if t.authBackend == nil {
