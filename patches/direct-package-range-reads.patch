+
+// readMacPackageMetadataFromRanges parses the installer metadata out of a Mac
+// package without downloading it. The XAR header, its table of contents and the
+// PackageInfo/Distribution entries stay readable on an encrypted installer, so
+// a few kilobytes replace the full download and Store-agent decryption.
+func (t *appstore) readMacPackageMetadataFromRanges(url string, preflight bool, bundleID string) (versionMetadata, error) {
+	if url == "" {
+		return versionMetadata{}, errors.New("package URL is empty")
+	}
+
+	attempts := t.macPackageRangeReadClients()
+	if len(attempts) == 0 {
+		return versionMetadata{}, errors.New("package read client is not configured")
+	}
+
+	var failures []string
+
+	for _, attempt := range attempts {
+		metadata, err := readMacPackageMetadataOverRanges(attempt.client, url, preflight, bundleID)
+		if err == nil {
+			metadata.PackageReadSource = attempt.source
+
+			return metadata, nil
+		}
+
+		failures = append(failures, fmt.Sprintf("%s read failed: %v", attempt.source, err))
+
+		// Bytes that arrived but are not an installer are the same for every
+		// client, so a second attempt would only open another guest for them.
+		if !isPackageReadTransportError(err) {
+			break
+		}
+	}
+
+	return versionMetadata{}, errors.New(strings.Join(failures, "; "))
+}
+
+// macPackageRangeReadClients lists the clients the ranged read may use: the
+// emulator-free Store transport first, then the regular Store client.
+func (t *appstore) macPackageRangeReadClients() []macPackageRangeReadAttempt {
+	attempts := make([]macPackageRangeReadAttempt, 0, 2)
+
+	if direct := directPackageReadClientFactory(t); direct != nil {
+		attempts = append(attempts, macPackageRangeReadAttempt{client: direct, source: packageReadSourceDirect})
+	}
+
+	// Without an auth backend the direct client already is the regular one, so
+	// a second attempt would repeat the same requests.
+	if t.authBackend != nil && t.httpClient != nil {
+		attempts = append(attempts, macPackageRangeReadAttempt{client: t.httpClient, source: packageReadSourceEmulated})
+	}
+
+	return attempts
+}
