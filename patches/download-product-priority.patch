+// availableStorefrontsPage fetches the public storefront list without the
+// account session. Apple varies the response by Cookie, and the Store cookies of
+// a signed-in account turn the plist into a non-200 answer, so discovery is sent
+// by a plain client that only looks like the Configurator.
+func availableStorefrontsPage(storeFront string) ([]byte, int, string, error) {
+	request, err := gohttp.NewRequest(gohttp.MethodGet, availableStorefrontsURL, nil)
+	if err != nil {
+		return nil, 0, "", err
+	}
+
+	request.Header.Set("User-Agent", storefrontRequestUserAgent)
+	request.Header.Set("X-Apple-Store-Front", storeFront)
+
+	client := &gohttp.Client{Timeout: 30 * time.Second}
+
+	response, err := client.Do(request)
+	if err != nil {
+		return nil, 0, "", err
+	}
+
+	defer response.Body.Close()
+
+	body, err := io.ReadAll(io.LimitReader(response.Body, 4<<20))
+
+	return body, response.StatusCode, response.Header.Get("Server"), err
+}
+
+// bodySnippet keeps the beginning of an unexpected response in the error text so
+// a rejection by Apple can be told apart from a proxy or provider page.
+func bodySnippet(body []byte) string {
+	const limit = 160
+
+	snippet := strings.Join(strings.Fields(string(body)), " ")
+	if len(snippet) > limit {
+		snippet = snippet[:limit] + "..."
+	}
+
+	return snippet
+}
