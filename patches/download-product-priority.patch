+		if idx := strings.LastIndex(sf, ","); idx >= 0 {
+			prefix := ""
+			if strings.HasPrefix(sf, "143441-") && sfNumeric != "143441" {
+				prefix = "us"
+			}
+			sfTag = prefix + "sf" + sf[idx+1:]
+		}
+
+		// 1. Direct databases/101/items request (PurchaseHistoryItemsDAAPRequestEncoder.m in tvOS appstored).
+		if strings.HasSuffix(sf, ",29") {
+			directURL := fmt.Sprintf("%s/databases/%d/items?includeApplePubBooks=1&includeItemFlavors=1", PrivatePurchaseDAAPBaseURL, daapPurchasedDatabaseID)
+			directReq := buildDirectDAAPDatabase101Request(accForSF, guid, directURL, 0, true, allQuery, "", signer)
+			if directRes, directErr := t.ownedAppsClient.Send(directReq); directErr == nil && directRes.StatusCode == gohttp.StatusOK && len(directRes.Data) > 0 {
+				mstt, _, _ := firstDMAPUint(directRes.Data, "mstt")
+				parsed := parseDAAPExtendedItems(directRes.Data)
+				hid := 0
+				for _, it := range parsed {
+					if it.Hidden {
+						hid++
+					}
+				}
+				mergeItems(parsed)
+				passDiag = append(passDiag, fmt.Sprintf("%s.d101(st=%d,mstt=%d,n=%d,hid=%d)", sfTag, directRes.StatusCode, mstt, len(parsed), hid))
+			}
+		}
+
+		// 2. Session-based /login -> /update -> /databases/{101|<rev>}/items.
+		loginRes, loginErr := t.ownedAppsClient.Send(t.ownedAppsLoginRequest(accForSF, guid))
+		if loginErr != nil || loginRes.StatusCode != gohttp.StatusOK {
+			passDiag = append(passDiag, fmt.Sprintf("%s:login(%d)", sfTag, loginRes.StatusCode))
+			continue
+		}
+		sessionID, ok, parseErr := firstDMAPUint(loginRes.Data, "mlid")
+		if parseErr != nil || !ok || sessionID == 0 || sessionID > math.MaxUint32 {
+			passDiag = append(passDiag, fmt.Sprintf("%s:noMlid", sfTag))
+			continue
+		}
+
+		queriesForSF := []string{allQuery}
+		if strings.HasSuffix(sf, ",29") {
+			queriesForSF = []string{allQuery, tvQuery}
+		}
+
+		for qi, q := range queriesForSF {
+			updateRes, updateErr := t.ownedAppsClient.Send(t.ownedAppsUpdateRequest(accForSF, guid, uint32(sessionID), q, signer))
+			if updateErr != nil || updateRes.StatusCode != gohttp.StatusOK {
+				if qi == 0 {
+					passDiag = append(passDiag, fmt.Sprintf("%s:upd(%d)", sfTag, updateRes.StatusCode))
+				}
+				continue
+			}
+			latestVersion, ok, verErr := firstDMAPUint(updateRes.Data, "musr")
+			if verErr != nil || !ok || latestVersion == 0 || latestVersion > math.MaxUint32 {
+				continue
+			}
+
+			// Per BookLibraryCore (sub_241D6D70C) & BLDAAPItemsRequest:
+			// - databases/101/items uses musr = localVersion (0 on full sync) and mder = serverVersion (latestVersion)
+			// - databases/<latestVersion>/items uses musr = latestVersion and mder = 0
+			dbEndpoints := []struct {
+				label        string
+				url          string
+				localVersion uint32
+				deltaVersion uint32
+			}{
+				{
+					label:        "db101",
+					url:          fmt.Sprintf("%s/databases/%d/items?includeApplePubBooks=1&includeItemFlavors=1", PrivatePurchaseDAAPBaseURL, daapPurchasedDatabaseID),
+					localVersion: 0,
+					deltaVersion: uint32(latestVersion),
+				},
+				{
+					label:        "dbRev",
+					url:          fmt.Sprintf("%s/databases/%d/items?includeApplePubBooks=1&includeItemFlavors=1", PrivatePurchaseDAAPBaseURL, latestVersion),
+					localVersion: uint32(latestVersion),
+					deltaVersion: 0,
+				},
+			}
+
+			for _, dbEp := range dbEndpoints {
+				for _, includeMeta := range []bool{true, false} {
+					pageToken := ""
+					totalParsed := 0
+					hiddenParsed := 0
+					var firstStatus int
+					var firstMstt uint64
+					pagesFetched := 0
+
+					for page := 0; page < 10; page++ {
+						req := buildSessionDAAPExtendedItemsRequest(
+							accForSF,
+							guid,
+							dbEp.url,
+							uint32(sessionID),
+							dbEp.localVersion,
+							dbEp.deltaVersion,
+							includeMeta,
+							q,
+							pageToken,
+							signer,
+						)
+						res, itemsErr := t.ownedAppsClient.Send(req)
+						if page == 0 {
+							firstStatus = res.StatusCode
+							if len(res.Data) > 0 {
+								firstMstt, _, _ = firstDMAPUint(res.Data, "mstt")
+							}
+						}
+						if itemsErr != nil || res.StatusCode != gohttp.StatusOK || len(res.Data) == 0 {
+							break
+						}
+						pagesFetched++
+						parsed := parseDAAPExtendedItems(res.Data)
+						totalParsed += len(parsed)
+						for _, it := range parsed {
+							if it.Hidden {
+								hiddenParsed++
+							}
+						}
+						mergeItems(parsed)
+
+						nextToken, hasToken := firstDMAPString(res.Data, "mpag")
+						if !hasToken || nextToken == "" || nextToken == pageToken || len(parsed) == 0 {
+							break
+						}
+						pageToken = nextToken
+					}
+
+					if qi == 0 && (strings.HasSuffix(sf, ",29") || dbEp.label == "dbRev") {
+						passDiag = append(
+							passDiag,
+							fmt.Sprintf("%s.%s(m=%v,st=%d,mstt=%d,n=%d,hid=%d,pg=%d)", sfTag, dbEp.label, includeMeta, firstStatus, firstMstt, totalParsed, hiddenParsed, pagesFetched),
+						)
+					}
+					if totalParsed > 0 && includeMeta {
+						break
+					}
+				}
+			}
+		}
+	}
+
+	items := make([]DAAPOwnedAppItem, 0, len(mergedByID))
+	byAppID := make(map[int64]DAAPOwnedAppItem, len(mergedByID))
+	for _, item := range mergedByID {
+		if item.SupportsLayeredImage {
+			item.App.Platforms = mergePlatformSlices(item.App.Platforms, []Platform{PlatformAppleTV})
+		}
+		items = append(items, *item)
+		byAppID[item.App.ID] = *item
+	}
+
+	diagStr := strings.Join(passDiag, ",")
+	if len(items) > 0 {
+		tvosResolveMu.Lock()
+		daapExtendedCache[dsid] = daapExtendedCacheEntry{
+			items:        items,
+			byAppID:      byAppID,
+			debugSummary: diagStr,
+			updatedAt:    time.Now(),
+		}
+		tvosResolveMu.Unlock()
+	}
+
+	return items, diagStr, nil
+}
+
+func (t *appstore) fetchDAAPSingleAppCandidates(acc Account, appID int64) ([]string, string) {
+	if appID <= 0 || t.ownedAppsClient == nil {
+		return nil, ""
+	}
+
+	guid, signer := t.newDAAPActionSigner()
+	if signer != nil {
+		defer func() { _ = signer.Close() }()
+	}
+	if guid == "" {
+		return nil, ""
+	}
+
+	sfBase, _, _ := strings.Cut(strings.TrimSpace(acc.StoreFront), ",")
+	if sfBase == "" {
+		sfBase = "143441-1"
+	}
+	sfNumeric, _, _ := strings.Cut(sfBase, "-")
+
+	queries := []string{
+		fmt.Sprintf("('com.apple.itunes.itms\\-songid:%d')", appID),
+		fmt.Sprintf("('dmap.itemid:%d')", appID),
+		fmt.Sprintf("('dmap.longitemid:%d')", appID),
+		fmt.Sprintf("(('com.apple.itunes.extended\\-media\\-kind:%d','com.apple.itunes.extended\\-media\\-kind:%d','com.apple.itunes.extended\\-media\\-kind:%d','com.apple.itunes.extended\\-media\\-kind:%d')+'com.apple.itunes.itms\\-songid:%d')", ownedAppsMediaKind, ownedArcadeAppsMediaKind, ownedTVAppsMediaKind, ownedMacAppsMediaKind, appID),
+	}
+	var candidates []string
+	var debugParts []string
+
+	collectFromResponse := func(data []byte) {
+		for _, item := range parseDAAPExtendedItems(data) {
+			if item.App.ID == 0 || item.App.ID == appID {
+				if item.DebugSummary != "" && !slices.Contains(debugParts, item.DebugSummary) {
+					debugParts = append(debugParts, item.DebugSummary)
+				}
+				for _, v := range item.RedownloadVersionIDs {
+					candidates = appendUniqueString(candidates, v)
+				}
+			}
+		}
+	}
+
+	storefronts := []string{sfBase + ",29", sfBase + ",34"}
+	if sfNumeric != "143441" {
+		storefronts = append(storefronts, "143441-1,29")
+	}
+
+	db101URL := fmt.Sprintf("%s/databases/%d/items?includeApplePubBooks=1&includeItemFlavors=1", PrivatePurchaseDAAPBaseURL, daapPurchasedDatabaseID)
+
+	for _, sf := range storefronts {
+		accForSF := acc
+		accForSF.StoreFront = sf
+
+		for _, q := range queries {
+			for _, includeMeta := range []bool{true, false} {
+				directReq := buildDirectDAAPDatabase101Request(accForSF, guid, db101URL, 0, includeMeta, q, "", signer)
+				if res, err := t.ownedAppsClient.Send(directReq); err == nil && res.StatusCode == gohttp.StatusOK && len(res.Data) > 0 {
+					collectFromResponse(res.Data)
+				}
+			}
+		}
+
+		loginRes, loginErr := t.ownedAppsClient.Send(t.ownedAppsLoginRequest(accForSF, guid))
+		if loginErr != nil || loginRes.StatusCode != gohttp.StatusOK {
+			continue
+		}
+		sessionID, ok, parseErr := firstDMAPUint(loginRes.Data, "mlid")
+		if parseErr != nil || !ok || sessionID == 0 || sessionID > math.MaxUint32 {
+			continue
+		}
+		for _, q := range queries {
+			updateRes, updateErr := t.ownedAppsClient.Send(t.ownedAppsUpdateRequest(accForSF, guid, uint32(sessionID), q, signer))
+			if updateErr != nil || updateRes.StatusCode != gohttp.StatusOK {
+				continue
+			}
+			latestVersion, ok, verErr := firstDMAPUint(updateRes.Data, "musr")
+			if verErr != nil || !ok || latestVersion == 0 || latestVersion > math.MaxUint32 {
+				continue
+			}
+			dbSpecs := []struct {
+				url      string
+				localVer uint32
+				deltaVer uint32
+			}{
+				{
+					url:      db101URL,
+					localVer: 0,
+					deltaVer: uint32(latestVersion),
+				},
+				{
+					url:      fmt.Sprintf("%s/databases/%d/items?includeApplePubBooks=1&includeItemFlavors=1", PrivatePurchaseDAAPBaseURL, latestVersion),
+					localVer: uint32(latestVersion),
+					deltaVer: 0,
+				},
+			}
+			for _, dbSpec := range dbSpecs {
+				for _, includeMeta := range []bool{true, false} {
+					req := buildSessionDAAPExtendedItemsRequest(accForSF, guid, dbSpec.url, uint32(sessionID), dbSpec.localVer, dbSpec.deltaVer, includeMeta, q, "", signer)
+					if res, itemsErr := t.ownedAppsClient.Send(req); itemsErr == nil && res.StatusCode == gohttp.StatusOK && len(res.Data) > 0 {
+						collectFromResponse(res.Data)
+					}
+				}
+			}
+		}
+	}
+
+	return candidates, strings.Join(debugParts, "; ")
+}
+
+// ResolveTVOSVersionsAndLatest resolves the tvOS softwareVersionExternalIdentifiers
+// train and latest externalVersionId for a delisted/hidden tvOS or universal app
+// without downloading the IPA package.
+func ResolveTVOSVersionsAndLatest(service AppStore, ctx context.Context, acc Account, app App, seedVersionIDs []string) ([]string, string, error) {
+	store, ok := service.(*appstore)
+	if !ok || store == nil {
+		return nil, "", errors.New("unexpected appstore implementation")
+	}
+	return store.resolveTVOSVersionsAndLatest(ctx, acc, app, seedVersionIDs)
+}
+
+func (t *appstore) resolveTVOSVersionsAndLatest(ctx context.Context, acc Account, app App, seedVersionIDs []string) ([]string, string, error) {
+	if app.ID <= 0 {
+		return nil, "", errors.New("app ID is required")
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+
+	cacheKey := fmt.Sprintf("%s:%d", strings.TrimSpace(acc.DirectoryServicesID), app.ID)
+	tvosResolveMu.Lock()
+	if cached, ok := tvosResolvedTrainCache[cacheKey]; ok && time.Since(cached.updatedAt) < 30*time.Minute && cached.latestID != "" {
+		ids := append([]string(nil), cached.versionIDs...)
+		latest := cached.latestID
+		tvosResolveMu.Unlock()
+		return ids, latest, nil
+	}
+	tvosResolveMu.Unlock()
+
+	macAddr, err := t.machine.MacAddress()
+	if err != nil {
+		return nil, "", fmt.Errorf("failed to get mac address: %w", err)
+	}
+	guid := strings.ReplaceAll(strings.ToUpper(macAddr), ":", "")
+
+	nonTVOSTrainSet := make(map[string]struct{})
+	var unpinnedFirstSeen string
+	var unpinnedLatestSeen string
+
+	// Step 1: Probe unpinned sendDownloadProduct and inspect remote Info.plist via HTTP Range.
+	unpinnedRes, _, unpinnedErr := t.sendDownloadProduct(ctx, acc, app, guid, "", PlatformAppleTV)
+	if unpinnedErr == nil {
+		if unpinnedRes.Data.FailureType == FailureTypePasswordTokenExpired ||
+			unpinnedRes.Data.FailureType == FailureTypeSignInRequired ||
+			unpinnedRes.Data.FailureType == FailureTypeDeviceVerificationFailed ||
+			unpinnedRes.Data.FailureType == FailureTypeLicenseAlreadyExists {
+			return nil, "", ErrPasswordTokenExpired
+		}
+		if unpinnedRes.Data.FailureType == FailureTypeLicenseNotFound {
+			return nil, "", ErrLicenseRequired
+		}
+		if len(unpinnedRes.Data.Items) > 0 {
+			item := unpinnedRes.Data.Items[0]
+			ids, latest := extractVersionListAndLatest(item.Metadata)
+			if len(ids) > 0 {
+				unpinnedFirstSeen = ids[0]
+			}
+			unpinnedLatestSeen = latest
+			if item.URL != "" {
+				if platforms, platErr := t.readPackageSupportedPlatformsFromIPA(item.URL); platErr == nil {
+					if containsPlatformString(platforms, "AppleTVOS") {
+						if latest == "" && len(ids) > 0 {
+							latest = ids[len(ids)-1]
+						}
+						t.cacheResolvedTVOSTrain(cacheKey, app.ID, ids, latest)
+						return ids, latest, nil
+					}
+					// Confirmed non-tvOS build (e.g. iPhoneOS train for a universal app).
+					for _, id := range ids {
+						nonTVOSTrainSet[id] = struct{}{}
+					}
+					if latest != "" {
+						nonTVOSTrainSet[latest] = struct{}{}
+					}
+				}
+			}
+		}
+	}
+
+	// Step 2: Gather candidate externalVersionIds from seeds, DAAP purchase history, and tvOS native endpoints.
+	var candidates []string
+	for _, seed := range seedVersionIDs {
+		candidates = appendUniqueString(candidates, strings.TrimSpace(seed))
+	}
+
+	tvosResolveMu.Lock()
+	for _, seed := range knownTVOSVersionSeeds[app.ID] {
+		candidates = appendUniqueString(candidates, seed)
+	}
+	tvosResolveMu.Unlock()
+
+	var daapItemDebug string
+	var daapPassDebug string
+	var daapTotalCount int
+	if daapItems, passDiag, daapErr := t.fetchDAAPOwnedAppsExtended(acc, true); daapErr == nil {
+		daapTotalCount = len(daapItems)
+		daapPassDebug = passDiag
+		for _, item := range daapItems {
+			if item.App.ID == app.ID {
+				daapItemDebug = item.DebugSummary
+				for _, verID := range item.RedownloadVersionIDs {
+					candidates = appendUniqueString(candidates, verID)
+				}
+			}
+		}
+	}
+
+	singleCands, singleDebug := t.fetchDAAPSingleAppCandidates(acc, app.ID)
+	for _, verID := range singleCands {
+		candidates = appendUniqueString(candidates, verID)
+	}
+	if singleDebug != "" {
+		if daapItemDebug == "" {
+			daapItemDebug = singleDebug
+		} else if !strings.Contains(daapItemDebug, singleDebug) {
+			daapItemDebug = daapItemDebug + " | " + singleDebug
+		}
+	}
+
+	// Step 2b: Probe native tvOS MZSoftwareUpdate / contentRestore endpoints.
+	var probeDebug string
+	hasNonIOSCandidate := false
+	for _, c := range candidates {
+		if _, isIOS := nonTVOSTrainSet[c]; !isIOS && c != "" && c != "0" {
+			hasNonIOSCandidate = true
+			break
+		}
+	}
+	if !hasNonIOSCandidate {
+		probeIDs, probeLatest, extraCands, ok, pDebug := t.probeTVOSNativeEndpoints(ctx, acc, app, guid, unpinnedFirstSeen, unpinnedLatestSeen, nonTVOSTrainSet)
+		probeDebug = pDebug
+		if ok {
+			t.cacheResolvedTVOSTrain(cacheKey, app.ID, probeIDs, probeLatest)
+			return probeIDs, probeLatest, nil
+		}
+		for _, ec := range extraCands {
+			candidates = appendUniqueString(candidates, ec)
+		}
+	}
+
+	// Step 3: Test each candidate externalVersionId against sendDownloadProduct + remote Info.plist check.
+	for _, candID := range candidates {
+		candID = strings.TrimSpace(candID)
+		if candID == "" || candID == "0" {
+			continue
+		}
+		if _, isNonTVOS := nonTVOSTrainSet[candID]; isNonTVOS {
+			continue
+		}
+
+		candRes, _, candErr := t.sendDownloadProduct(ctx, acc, app, guid, candID, PlatformAppleTV)
+		if candErr != nil || len(candRes.Data.Items) == 0 {
+			continue
+		}
+
+		candItem := candRes.Data.Items[0]
+		candIDs, candLatest := extractVersionListAndLatest(candItem.Metadata)
+		if len(candIDs) > 0 {
+			// The last element in softwareVersionExternalIdentifiers is the newest build on this train.
+			candLatest = candIDs[len(candIDs)-1]
+		}
+		if candLatest == "" {
+			candLatest = candID
+		}
+
+		isTVOS := false
+		if candItem.URL != "" {
+			if platforms, platErr := t.readPackageSupportedPlatformsFromIPA(candItem.URL); platErr == nil {
+				if containsPlatformString(platforms, "AppleTVOS") {
+					isTVOS = true
+				} else {
+					for _, id := range candIDs {
+						nonTVOSTrainSet[id] = struct{}{}
+					}
+					continue
+				}
+			} else if len(nonTVOSTrainSet) > 0 {
+				// Remote range check failed transiently, but candID is disjoint from the iPhoneOS train.
+				isTVOS = true
+			}
+		}
+
+		if isTVOS {
+			if len(candIDs) == 0 {
+				candIDs = []string{candLatest}
+			}
+			t.cacheResolvedTVOSTrain(cacheKey, app.ID, candIDs, candLatest)
+			return candIDs, candLatest, nil
+		}
+	}
+
+	return nil, "", fmt.Errorf(
+		"tvOS resolve diagnostics for %d: unpinnedLatest=%s, iOSTrainCount=%d, daapTotal=%d(%s), daapItem=[%s], probes=[%s], candidates=%v",
+		app.ID,
+		unpinnedLatestSeen,
+		len(nonTVOSTrainSet),
+		daapTotalCount,
+		daapPassDebug,
+		daapItemDebug,
+		probeDebug,
+		candidates,
+	)
+}
+
+func (t *appstore) cacheResolvedTVOSTrain(cacheKey string, appID int64, ids []string, latest string) {
+	if latest == "" && len(ids) > 0 {
+		latest = ids[len(ids)-1]
+	}
+	if latest == "" {
+		return
+	}
+	if len(ids) == 0 {
+		ids = []string{latest}
+	}
+
+	tvosResolveMu.Lock()
+	tvosResolvedTrainCache[cacheKey] = tvosResolvedTrainEntry{
+		versionIDs: append([]string(nil), ids...),
+		latestID:   latest,
+		updatedAt:  time.Now(),
+	}
+	knownTVOSVersionSeeds[appID] = appendUniqueString(knownTVOSVersionSeeds[appID], latest)
+	tvosResolveMu.Unlock()
+}
+
+func (t *appstore) probeTVOSNativeEndpoints(
+	ctx context.Context,
+	acc Account,
+	app App,
+	guid, unpinnedFirstSeen, unpinnedLatestSeen string,
+	nonTVOSTrainSet map[string]struct{},
+) ([]string, string, []string, bool, string) {
+	if t.downloadClient == nil {
+		return nil, "", nil, false, "noClient"
+	}
+
+	hardwareID, err := hex.DecodeString(guid)
+	if err != nil || len(hardwareID) != 6 {
+		return nil, "", nil, false, "badGUID"
+	}
+
+	dsid, err := strconv.ParseUint(strings.TrimSpace(acc.DirectoryServicesID), 10, 64)
+	if err != nil || dsid == 0 {
+		return nil, "", nil, false, "badDSID"
+	}
+
+	kbsync := t.cachedKBSync(dsid, guid)
+	if kbsync == "" {
+		kbsync, err = t.generateKBSync(ctx, hardwareID, dsid)
+		if err != nil || kbsync == "" {
+			return nil, "", nil, false, "kbsyncErr"
+		}
+		t.storeKBSync(dsid, guid, kbsync)
+	}
+	rawKBSync, _ := base64.StdEncoding.DecodeString(kbsync)
+
+	serial := append([]byte{0x54, 0xc8, 0xb0, 0xa9, 0x88}, hardwareID[2:]...)
+	serialB64 := base64.StdEncoding.EncodeToString(serial)
+
+	sfBase, _, _ := strings.Cut(strings.TrimSpace(acc.StoreFront), ",")
+	if sfBase == "" {
+		sfBase = "143441-1"
+	}
+	sfNumericStr, _, _ := strings.Cut(sfBase, "-")
+	sfNumericInt, _ := strconv.ParseInt(sfNumericStr, 10, 64)
+	if sfNumericInt <= 0 {
+		sfNumericInt = 143441
+	}
+	tvStoreFront := sfBase + ",29"
+
+	var diagParts []string
+	var extraCandidates []string
+
+	// 1. Probe MZSoftwareUpdate availableSoftwareUpdatesExtended & availableSoftwareUpdates (UpdatesTask.m / UpdatesTask.mm).
+	if t.ownedAppsClient != nil {
+		localSoftware := []map[string]interface{}{
+			{
+				"adam-id":                      app.ID,
+				"installed-version-identifier": int64(0),
+			},
+			{
+				"adam-id":                      app.ID,
+				"installed-version-identifier": int64(1),
+			},
+		}
+		if firstInt, parseErr := strconv.ParseInt(strings.TrimSpace(unpinnedFirstSeen), 10, 64); parseErr == nil && firstInt > 0 {
+			localSoftware = append(localSoftware, map[string]interface{}{
+				"adam-id":                      app.ID,
+				"installed-version-identifier": firstInt,
+			})
+		}
+		if latestInt, parseErr := strconv.ParseInt(strings.TrimSpace(unpinnedLatestSeen), 10, 64); parseErr == nil && latestInt > 0 {
+			localSoftware = append(localSoftware, map[string]interface{}{
+				"adam-id":                      app.ID,
+				"installed-version-identifier": latestInt,
+			})
+		}
+
+		suEndpoints := []struct {
+			name string
+			url  string
+		}{
+			{
+				name: "suExt",
+				url:  "https://su.itunes.apple.com/WebObjects/MZSoftwareUpdate.woa/wa/availableSoftwareUpdatesExtended",
+			},
+			{
+				name: "suStd",
+				url:  "https://su.itunes.apple.com/WebObjects/MZSoftwareUpdate.woa/wa/availableSoftwareUpdates",
+			},
+		}
+
+		for _, suEp := range suEndpoints {
+			if ctx != nil && ctx.Err() != nil {
+				break
+			}
+			suReq := http.Request{
+				URL:            suEp.url,
+				Method:         http.MethodPOST,
+				ResponseFormat: http.ResponseFormatRaw,
+				Headers: map[string]string{
+					"Content-Type":        "application/x-apple-plist",
+					"User-Agent":          configuratorEntUA,
+					"X-Apple-Store-Front": tvStoreFront,
+					"X-Apple-TA-Device":   tvosTADeviceVariants,
+					"X-Dsid":              acc.DirectoryServicesID,
+					"iCloud-DSID":         acc.DirectoryServicesID,
+					"X-Token":             acc.PasswordToken,
+				},
+				Payload: &http.XMLPayload{
+					Content: map[string]interface{}{
+						"autoUpdatesEnabled": true,
+						"guid":               guid,
+						"kbsync":             kbsync,
+						"local-software":     localSoftware,
+					},
+				},
+			}
+			suRes, suErr := t.ownedAppsClient.Send(suReq)
+			if suErr != nil || len(suRes.Data) == 0 {
+				diagParts = append(diagParts, fmt.Sprintf("%s:err(%d)", suEp.name, suRes.StatusCode))
+				continue
+			}
+
+			foundCands := extractCandidatesFromRawUpdateResponse(suRes.Data)
+			nonIOSCount := 0
+			for _, c := range foundCands {
+				if _, isIOS := nonTVOSTrainSet[c]; !isIOS {
+					extraCandidates = appendUniqueString(extraCandidates, c)
+					nonIOSCount++
+				}
+			}
+			diagParts = append(diagParts, fmt.Sprintf("%s:st=%d,c=%d(tv=%d)", suEp.name, suRes.StatusCode, len(foundCands), nonIOSCount))
+		}
+	}
+
+	// 2. Probe p2-content-restore with Configurator/2.18 UA + NSData kbsync.
+	var kbsyncDataVal interface{} = kbsync
+	if len(rawKBSync) > 0 {
+		kbsyncDataVal = rawKBSync
+	}
+	restoreItems := []map[string]interface{}{
+		{
+			"item-id":        app.ID,
+			"kind":           "software",
+			"flavor":         "1:software",
+			"store-front-id": sfNumericInt,
+		},
+		{
+			"item-id":        strconv.FormatInt(app.ID, 10),
+			"kind":           "software",
+			"store-front-id": tvStoreFront,
+		},
+	}
+
+	crReq := http.Request{
+		URL:            fmt.Sprintf("https://downloaddispatch.itunes.apple.com/contentRestore?guid=%s", guid),
+		Method:         http.MethodPOST,
+		ResponseFormat: http.ResponseFormatXML,
+		NoRedirects:    true,
+		Headers: map[string]string{
+			"Content-Type":        "application/x-apple-plist",
+			"User-Agent":          configuratorEntUA,
+			"X-Apple-Store-Front": tvStoreFront,
+			"X-Apple-TA-Device":   tvosTADeviceVariants,
+			"X-Dsid":              acc.DirectoryServicesID,
+			"iCloud-DSID":         acc.DirectoryServicesID,
+			"X-Token":             acc.PasswordToken,
+		},
+		Payload: &http.XMLPayload{
+			Content: map[string]interface{}{
+				"device-name":   "Apple TV",
+				"guid":          guid,
+				"serial-number": serialB64,
+				"kbsync":        kbsyncDataVal,
+				"items":         restoreItems,
+			},
+		},
+	}
+
+	if crRes, crErr := t.downloadClient.Send(crReq); crErr == nil {
+		allItems := append([]downloadItemResult(nil), crRes.Data.Items...)
+		allItems = append(allItems, crRes.Data.RestoreItems...)
+		if len(allItems) == 0 {
+			failInfo := crRes.Data.FailureType
+			if failInfo == "" && len(crRes.Data.FailedItems) > 0 {
+				if ft, ok := crRes.Data.FailedItems[0]["failureType"]; ok {
+					failInfo = fmt.Sprintf("fi:%v", ft)
+				}
+			}
+			diagParts = append(diagParts, fmt.Sprintf("crCfg:empty(st=%d,ft=%s)", crRes.StatusCode, failInfo))
+		} else {
+			for _, item := range allItems {
+				ids, latest := extractVersionListAndLatest(item.Metadata)
+				_, isIOS := nonTVOSTrainSet[latest]
+				diagParts = append(diagParts, fmt.Sprintf("crCfg:item(lat=%s,n=%d,ios=%v)", latest, len(ids), isIOS))
+				if latest != "" && !isIOS {
+					if item.URL != "" {
+						if platforms, platErr := t.readPackageSupportedPlatformsFromIPA(item.URL); platErr == nil && containsPlatformString(platforms, "AppleTVOS") {
+							if len(ids) == 0 {
+								ids = []string{latest}
+							}
+							return ids, ids[len(ids)-1], extraCandidates, true, strings.Join(diagParts, ",")
+						}
+					}
+					extraCandidates = appendUniqueString(extraCandidates, latest)
+				}
+			}
+		}
+	}
+
+	return nil, "", extraCandidates, false, strings.Join(diagParts, ",")
+}
+
+func extractCandidatesFromRawUpdateResponse(data []byte) []string {
+	var out []string
+	var collectMap func(v interface{})
+	collectMap = func(v interface{}) {
+		switch typed := v.(type) {
+		case map[string]interface{}:
+			for k, val := range typed {
+				kl := strings.ToLower(k)
+				if kl == "externalid" || kl == "versionid" || kl == "appextvrsid" || kl == "externalversionid" || kl == "softwareversionexternalidentifier" {
+					s := strings.TrimSpace(fmt.Sprintf("%v", val))
+					if bareDigitsPattern.MatchString(s) {
+						out = appendUniqueString(out, s)
+					}
+				} else if kl == "buyparams" || kl == "action-params" {
+					for _, id := range extractRedownloadVersionIDs(fmt.Sprintf("%v", val)) {
+						out = appendUniqueString(out, id)
+					}
+				} else {
+					collectMap(val)
+				}
+			}
+		case []interface{}:
+			for _, elem := range typed {
+				collectMap(elem)
+			}
+		}
+	}
+
+	var plistObj interface{}
+	if _, err := plist.Unmarshal(data, &plistObj); err == nil && plistObj != nil {
+		collectMap(plistObj)
+	}
+	var jsonObj interface{}
+	if err := json.Unmarshal(data, &jsonObj); err == nil && jsonObj != nil {
+		collectMap(jsonObj)
+	}
+	for _, id := range extractRedownloadVersionIDs(string(data)) {
+		out = appendUniqueString(out, id)
+	}
+	return out
+}
+
+func (t *appstore) readPackageSupportedPlatformsFromIPA(packageURL string) ([]string, error) {
+	reader, size, err := newHTTPRangeReaderAt(t.httpClient, packageURL)
+	if err != nil {
+		return nil, err
+	}
+
+	zipReader, err := zip.NewReader(newBufferedRangeReaderAt(reader, size), size)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open zip reader: %w", err)
+	}
+
+	for _, file := range zipReader.File {
+		if !isMainAppInfoPlist(file.Name) {
+			continue
+		}
+
+		src, openErr := file.Open()
+		if openErr != nil {
+			return nil, openErr
+		}
+		data, readErr := io.ReadAll(src)
+		_ = src.Close()
+		if readErr != nil {
+			return nil, readErr
+		}
+
+		metadata := map[string]interface{}{}
+		if _, unmarshalErr := plist.Unmarshal(data, &metadata); unmarshalErr != nil {
+			return nil, unmarshalErr
+		}
+
+		var platforms []string
+		if raw, ok := metadata["CFBundleSupportedPlatforms"].([]interface{}); ok {
+			for _, item := range raw {
+				if s := strings.TrimSpace(fmt.Sprintf("%v", item)); s != "" {
+					platforms = appendUniqueString(platforms, s)
+				}
+			}
+		} else if rawStrs, ok := metadata["CFBundleSupportedPlatforms"].([]string); ok {
+			for _, s := range rawStrs {
+				if s = strings.TrimSpace(s); s != "" {
+					platforms = appendUniqueString(platforms, s)
+				}
+			}
+		}
+
+		if dtPlatform, ok := metadata["DTPlatformName"].(string); ok {
+			dtPlatform = strings.ToLower(strings.TrimSpace(dtPlatform))
+			if dtPlatform == "appletvos" {
+				platforms = appendUniqueString(platforms, "AppleTVOS")
+			} else if dtPlatform == "iphoneos" {
+				platforms = appendUniqueString(platforms, "iPhoneOS")
+			}
+		}
+
+		if _, hasTVOSMin := metadata["TVOSMinimumOSVersion"]; hasTVOSMin {
+			platforms = appendUniqueString(platforms, "AppleTVOS")
+		}
+
+		return platforms, nil
+	}
+
+	return nil, errors.New("could not find Info.plist")
+}
+
+func extractVersionListAndLatest(metadata map[string]interface{}) ([]string, string) {
+	if metadata == nil {
+		return nil, ""
+	}
+	var ids []string
+	if rawList, ok := metadata["softwareVersionExternalIdentifiers"].([]interface{}); ok {
+		for _, v := range rawList {
+			s := strings.TrimSpace(fmt.Sprintf("%v", v))
+			if s != "" && s != "<nil>" {
+				ids = append(ids, s)
+			}
+		}
+	}
+	latest := ""
+	if rawLatest, ok := metadata["softwareVersionExternalIdentifier"]; ok && rawLatest != nil {
+		s := strings.TrimSpace(fmt.Sprintf("%v", rawLatest))
+		if s != "" && s != "<nil>" {
+			latest = s
+		}
+	}
+	if latest == "" && len(ids) > 0 {
+		latest = ids[len(ids)-1]
+	}
+	return ids, latest
+}
+
+func containsPlatformString(platforms []string, want string) bool {
+	for _, p := range platforms {
+		if strings.EqualFold(strings.TrimSpace(p), want) {
+			return true
+		}
+	}
+	return false
+}
+
+func appendUniqueString(slice []string, val string) []string {
+	val = strings.TrimSpace(val)
+	if val == "" {
+		return slice
+	}
+	for _, item := range slice {
+		if item == val {
+			return slice
+		}
+	}
+	return append(slice, val)
+}
+
+func mergePlatformSlices(base, extra []Platform) []Platform {
+	out := append([]Platform(nil), base...)
+	for _, p := range extra {
+		if p == "" || p == PlatformUnknown {
+			continue
+		}
+		if !slices.Contains(out, p) {
+			out = append(out, p)
+		}
+	}
+	out = slices.DeleteFunc(out, func(p Platform) bool {
+		return p == PlatformUnknown && len(out) > 1
+	})
+	return out
+}
+
+// applyDAAPExtendedHeaders sets DAAP headers while preserving Configurator User-Agent
+// (so Apple's DAAP server accepts Configurator session tokens) and removing X-FM-Dsid
+// (which is familyMemberStoreID for Family Sharing and causes Apple's DAAP server to
+// filter out hidden/delisted items).
+func applyDAAPExtendedHeaders(headers map[string]string) {
+	headers["Client-Cloud-Daap-Version"] = tvosCloudDAAPVersion
+	headers["Client-Cloud-Purchase-Daap-Version"] = tvosPurchaseDAAPVer
+	headers["Client-Cloud-Purchase-DAAP-Version"] = tvosPurchaseDAAPVer
+	delete(headers, "X-FM-Dsid")
+	headers["X-DAAP-Supported-Features"] = "16"
+}
+
+func buildDirectDAAPDatabase101Request(
+	acc Account,
+	guid, requestURL string,
+	revision uint32,
+	includeMeta bool,
+	customQuery, paginationToken string,
+	signer ActionSigner,
+) http.Request {
+	now := time.Now()
+	query := customQuery
+	if query == "" {
+		query = defaultDAAPAllMediaKindsQuery()
+	}
+
+	tags := make([]byte, 0, 512)
+	if includeMeta {
+		tags = append(tags, dmapString("meta", daapExtendedMetaFields)...)
+	}
+	tags = append(tags, dmapUint32("musr", revision)...)
+	tags = append(tags, dmapUint8("mhid", 1)...)
+	tags = append(tags, dmapUint8("ajIp", 1)...)
+	if paginationToken != "" {
+		tags = append(tags, dmapString("mpag", paginationToken)...)
+	}
+	tags = append(tags, dmapString("mque", query)...)
+	tags = append(tags, dmapTag("aetl", nil)...)
+
+	body := dmapTag("adsr", tags)
+
+	headers := ownedAppsHeaders(acc, guid, now)
+	headers["Content-Type"] = "application/x-dmap-tagged"
+	applyDAAPExtendedHeaders(headers)
+
+	if requestURL == "" {
+		requestURL = fmt.Sprintf("%s/databases/%d/items?includeApplePubBooks=1&includeItemFlavors=1", PrivatePurchaseDAAPBaseURL, daapPurchasedDatabaseID)
+	}
+
+	return http.Request{
+		URL:            requestURL,
+		Method:         http.MethodPOST,
+		ResponseFormat: http.ResponseFormatRaw,
+		Headers:        headers,
+		Payload:        &http.RawPayload{Content: body},
+		ActionSigner:   signer,
+	}
+}
