@@ -0,0 +1,210 @@
+package appstore
+
+import (
+	"context"
+	gohttp "net/http"
+	"testing"
+
+	"github.com/majd/ipatool/v2/pkg/http"
+	"go.uber.org/mock/gomock"
+)
+
+// The version history lookup asks for one pinned build, and Apple answers the
+// legacy volumeStore offer for those builds with 200 and no item, and the
+// redownload fallback with HTTP 403 every time. The kbsync ent/download
+// endpoint is the one that serves them, so the history chain starts there and
+// keeps the other two as fallbacks. Download and ListVersions keep the regular
+// order, where the legacy offer is what serves the version list itself.
+func TestVersionHistoryDownloadChain(t *testing.T) {
+	const versionID = "818970197"
+
+	store, downloads, bags, account, app, guid := newVersionHistoryStore(t)
+	bag := newVersionHistoryBag()
+
+	gomock.InOrder(
+		bags.EXPECT().Send(gomock.Any()).Return(bag, nil),
+		downloads.EXPECT().Send(gomock.Any()).Do(func(req http.Request) {
+			assertEntDownloadRequest(t, req, account, guid, versionID)
+		}).Return(versionHistoryItemResponse(app, versionID), nil),
+	)
+
+	result, platform, err := store.sendDownloadProductForVersionHistory(
+		context.Background(), account, app, guid, versionID, PlatformIPhone)
+	if err != nil {
+		t.Fatalf("sendDownloadProductForVersionHistory() error = %v", err)
+	}
+
+	if len(result.Data.Items) != 1 || result.Data.Items[0].URL != "https://example.test/app.ipa" {
+		t.Fatalf("sendDownloadProductForVersionHistory() items = %+v", result.Data.Items)
+	}
+
+	if platform != PlatformIPhone {
+		t.Fatalf("sendDownloadProductForVersionHistory() platform = %q", platform)
+	}
+
+	// gomock fails the test on any further download request, so reaching this
+	// point means the history lookup spent exactly one Store request.
+}
+
+func TestVersionHistoryFallsBackToVolumeStore(t *testing.T) {
+	const versionID = "818970197"
+
+	store, downloads, bags, account, app, guid := newVersionHistoryStore(t)
+	bag := newVersionHistoryBag()
+
+	gomock.InOrder(
+		bags.EXPECT().Send(gomock.Any()).Return(bag, nil),
+		downloads.EXPECT().Send(gomock.Any()).Do(func(req http.Request) {
+			assertEntDownloadRequest(t, req, account, guid, versionID)
+		}).Return(http.Result[downloadResult]{StatusCode: gohttp.StatusOK}, nil),
+		downloads.EXPECT().Send(gomock.Any()).Do(func(req http.Request) {
+			if want := store.volumeStoreEndpoint(account).baseURL + "?guid=" + guid; req.URL != want {
+				t.Fatalf("volumeStore URL = %q, want %q", req.URL, want)
+			}
+
+			payload := req.Payload.(*http.XMLPayload).Content
+			if payload["externalVersionId"] != versionID {
+				t.Fatalf("volumeStore externalVersionId = %v, want %q", payload["externalVersionId"], versionID)
+			}
+		}).Return(versionHistoryItemResponse(app, versionID), nil),
+	)
+
+	result, _, err := store.sendDownloadProductForVersionHistory(
+		context.Background(), account, app, guid, versionID, PlatformIPhone)
+	if err != nil {
+		t.Fatalf("sendDownloadProductForVersionHistory() error = %v", err)
+	}
+
+	if len(result.Data.Items) != 1 {
+		t.Fatalf("sendDownloadProductForVersionHistory() items = %+v", result.Data.Items)
+	}
+}
+
+func TestVersionHistoryKeepsTheLicenseError(t *testing.T) {
+	const versionID = "818970197"
+
+	store, downloads, bags, account, app, guid := newVersionHistoryStore(t)
+	bag := newVersionHistoryBag()
+
+	gomock.InOrder(
+		bags.EXPECT().Send(gomock.Any()).Return(bag, nil),
+		downloads.EXPECT().Send(gomock.Any()).Return(http.Result[downloadResult]{
+			StatusCode: gohttp.StatusOK,
+			Data:       downloadResult{FailureType: FailureTypeLicenseNotFound},
+		}, nil),
+		downloads.EXPECT().Send(gomock.Any()).Return(http.Result[downloadResult]{StatusCode: gohttp.StatusOK}, nil),
+	)
+
+	result, _, err := store.sendDownloadProductForVersionHistory(
+		context.Background(), account, app, guid, versionID, PlatformIPhone)
+	if err != nil {
+		t.Fatalf("sendDownloadProductForVersionHistory() error = %v", err)
+	}
+
+	// The GUI offers a purchase for this failure type, so it has to survive a
+	// chain that could not serve the build.
+	if result.Data.FailureType != FailureTypeLicenseNotFound {
+		t.Fatalf("failure type = %q, want %q", result.Data.FailureType, FailureTypeLicenseNotFound)
+	}
+}
+
+func TestRegularDownloadKeepsTheRedownloadFallback(t *testing.T) {
+	const versionID = "818970197"
+
+	store, downloads, bags, account, app, guid := newVersionHistoryStore(t)
+	bag := newVersionHistoryBag()
+
+	gomock.InOrder(
+		// The legacy offer is asked first, as before, and answers without an item.
+		downloads.EXPECT().Send(gomock.Any()).Do(func(req http.Request) {
+			if want := store.volumeStoreEndpoint(account).baseURL + "?guid=" + guid; req.URL != want {
+				t.Fatalf("volumeStore URL = %q, want %q", req.URL, want)
+			}
+		}).Return(http.Result[downloadResult]{StatusCode: gohttp.StatusOK}, nil),
+		bags.EXPECT().Send(gomock.Any()).Return(bag, nil),
+		downloads.EXPECT().Send(gomock.Any()).Do(func(req http.Request) {
+			if want := testRedownloadEndpoint + "?guid=" + guid; req.URL != want {
+				t.Fatalf("redownload URL = %q, want %q", req.URL, want)
+			}
+
+			if pinned, _ := req.Payload.(*http.XMLPayload).Content["appExtVrsId"]; pinned != versionID {
+				t.Fatalf("redownload appExtVrsId = %v, want %q", pinned, versionID)
+			}
+		}).Return(versionHistoryItemResponse(app, versionID), nil),
+	)
+
+	result, _, err := store.sendDownloadProduct(
+		context.Background(), account, app, guid, versionID, PlatformMacOS)
+	if err != nil {
+		t.Fatalf("sendDownloadProduct() error = %v", err)
+	}
+
+	if len(result.Data.Items) != 1 {
+		t.Fatalf("sendDownloadProduct() items = %+v", result.Data.Items)
+	}
+}
+
+func newVersionHistoryStore(t *testing.T) (*appstore, *http.MockClient[downloadResult], *http.MockClient[bagResult], Account, App, string) {
+	t.Helper()
+
+	ctrl := gomock.NewController(t)
+	downloads := http.NewMockClient[downloadResult](ctrl)
+	bags := http.NewMockClient[bagResult](ctrl)
+	store := &appstore{
+		downloadClient: downloads,
+		bagClient:      bags,
+		kbsyncGenerator: func(context.Context, []byte, uint64) ([]byte, error) {
+			return []byte("kbsync blob"), nil
+		},
+	}
+
+	account := Account{DirectoryServicesID: "1234", PasswordToken: "token", StoreFront: "143469-2,29"}
+	app := App{ID: 42, BundleID: "com.example.app"}
+
+	return store, downloads, bags, account, app, "001122334455"
+}
+
+func newVersionHistoryBag() http.Result[bagResult] {
+	return http.Result[bagResult]{
+		StatusCode: gohttp.StatusOK,
+		Data: bagResult{URLBag: urlBag{
+			EntDownloadEndpoint: testEntDownloadEndpoint,
+			RedownloadEndpoint:  testRedownloadEndpoint,
+		}},
+	}
+}
+
+func versionHistoryItemResponse(app App, versionID string) http.Result[downloadResult] {
+	return http.Result[downloadResult]{
+		StatusCode: gohttp.StatusOK,
+		Data: downloadResult{Items: []downloadItemResult{{
+			URL: "https://example.test/app.ipa",
+			Metadata: map[string]interface{}{
+				"itemId":                            app.ID,
+				"softwareVersionBundleId":           app.BundleID,
+				"softwareVersionExternalIdentifier": versionID,
+			},
+		}}},
+	}
+}
+
+func assertEntDownloadRequest(t *testing.T, req http.Request, account Account, guid, versionID string) {
+	t.Helper()
+
+	if want := testEntDownloadEndpoint + "?guid=" + guid; req.URL != want {
+		t.Fatalf("ent/download URL = %q, want %q", req.URL, want)
+	}
+
+	if req.Headers["X-Token"] != account.PasswordToken {
+		t.Fatalf("ent/download X-Token = %q", req.Headers["X-Token"])
+	}
+
+	payload := req.Payload.(*http.XMLPayload).Content
+	if blob, _ := payload["kbsync"].(string); blob == "" {
+		t.Fatal("ent/download request carries no kbsync blob")
+	}
+
+	if payload["externalVersionId"] != versionID {
+		t.Fatalf("ent/download externalVersionId = %v, want %q", payload["externalVersionId"], versionID)
+	}
+}
