+func normalizeAppleSpaces(in string) string {
+	replacer := strings.NewReplacer(
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+		" ", " ",
+	)
+
+	return strings.Join(strings.Fields(replacer.Replace(in)), " ")
+}
+
+func isRedownloadUnavailable(data downloadResult) bool {
+	if data.Dialog != nil {
+		msg, _ := data.Dialog["message"].(string)
+		exp, _ := data.Dialog["explanation"].(string)
+		if normalizeAppleSpaces(msg) == redownloadUnavailableMessage &&
+			normalizeAppleSpaces(exp) == redownloadUnavailableExplanation {
+			return true
+		}
+	}
+
+	return normalizeAppleSpaces(data.CustomerMessage) == redownloadUnavailableMessage
+}
