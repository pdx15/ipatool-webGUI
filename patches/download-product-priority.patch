+
+func effectiveFailureType(data downloadResult) string {
+	if ft := strings.TrimSpace(data.FailureType); ft != "" {
+		return ft
+	}
+
+	if data.Metrics != nil {
+		if raw, ok := data.Metrics["messageCode"]; ok && raw != nil {
+			if code := strings.TrimSpace(fmt.Sprint(raw)); code != "" && code != "<nil>" {
+				return code
+			}
+		}
+	}
+
+	return ""
+}
+
+func isAuthorizationDialog(dialog map[string]interface{}) bool {
+	if dialog == nil {
+		return false
+	}
+
+	kind, _ := dialog["kind"].(string)
+
+	return strings.EqualFold(strings.TrimSpace(kind), "authorization")
+}
+
+func isSignInRequiredMessage(message string) bool {
+	normalized := strings.ToLower(strings.TrimSpace(message))
+
+	return normalized == "sign in to the itunes store" || normalized == "sign-in required"
+}
+
+func isAuthFailureDownloadResult(data downloadResult) bool {
+	ft := effectiveFailureType(data)
+
+	return ft == FailureTypePasswordTokenExpired ||
+		ft == FailureTypeSignInRequired ||
+		ft == FailureTypeDeviceVerificationFailed ||
+		isSignInRequiredMessage(data.CustomerMessage)
+}
