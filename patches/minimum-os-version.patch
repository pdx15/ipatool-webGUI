+		}
+		if window < want {
+			window = want
+		}
+		fetchStart = off
+		fetchEnd = off + window
+		if b.bufStart > off && fetchEnd > b.bufStart && fetchEnd < b.size {
+			fetchEnd = b.bufStart
+		}
+		if fetchEnd > b.size {
