+// macPackageMinimumOSVersion reads the minimum allowed OS version from the
+// Distribution script at the root of a signed Mac package. The package's
+// PackageInfo carries the bundle version but not the OS requirement, and there
+// is no Info.plist to read, so Distribution is the only source for the badge in
+// the version history.
+func macPackageMinimumOSVersion(archive *xar.Reader) string {
+	for _, file := range archive.Files {
+		if file.Name != "Distribution" {
+			continue
+		}
+
+		source, err := file.Open()
+		if err != nil {
+			return ""
+		}
+
+		data, readErr := io.ReadAll(source)
+		closeErr := source.Close()
+
+		if err := errors.Join(readErr, closeErr); err != nil {
+			return ""
+		}
+
+		var script struct {
+			VolumeCheck struct {
+				AllowedOSVersions struct {
+					Versions []struct {
+						Min string `xml:"min,attr"`
+					} `xml:"os-version"`
+				} `xml:"allowed-os-versions"`
+			} `xml:"volume-check"`
+		}
+
+		if err := xml.Unmarshal(data, &script); err != nil {
+			return ""
+		}
+
+		for _, version := range script.VolumeCheck.AllowedOSVersions.Versions {
+			if minimum := strings.TrimSpace(version.Min); minimum != "" {
+				return minimum
+			}
+		}
+
+		return ""
+	}
+
+	return ""
+}
