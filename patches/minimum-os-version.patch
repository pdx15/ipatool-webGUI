+func (t *appstore) ipaSupportsPlatform(url string, platform Platform) (bool, bool) {
+	var expectedPlatform string
+
+	switch platform {
+	case PlatformIPhone, PlatformIPad:
+		expectedPlatform = "iPhoneOS"
+	case PlatformAppleTV:
+		expectedPlatform = "AppleTVOS"
+	case PlatformWatchOS:
+		expectedPlatform = "WatchOS"
+	case PlatformVisionOS:
+		expectedPlatform = "XROS"
+	default:
+		return true, false
+	}
+
+	reader, size, err := newHTTPRangeReaderAt(t.httpClient, url)
+	if err != nil {
+		return false, false
+	}
+
+	zipReader, err := zip.NewReader(newBufferedRangeReaderAt(reader, size), size)
+	if err != nil {
+		return false, false
+	}
+
+	for _, file := range zipReader.File {
+		if !isMainAppInfoPlist(file.Name) {
+			continue
+		}
+
+		src, openErr := file.Open()
+		if openErr != nil {
+			return false, false
+		}
+
+		data, readErr := io.ReadAll(src)
+		_ = src.Close()
+		if readErr != nil {
+			return false, false
+		}
+
+		var info platformPackageInfo
+		if _, decodeErr := plist.Unmarshal(data, &info); decodeErr != nil {
+			return false, false
+		}
+
+		for _, supported := range info.SupportedPlatforms {
+			if supported == expectedPlatform {
+				return true, true
+			}
+		}
+
+		return false, true
+	}
+
+	return false, false
+}
