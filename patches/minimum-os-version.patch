+func readMinimumOSVersionFromInfoPlist(metadata map[string]interface{}) string {
+	value, ok := metadata["MinimumOSVersion"]
+	if !ok || value == nil {
+		return ""
+	}
+
+	minimumOSVersion := strings.TrimSpace(fmt.Sprintf("%v", value))
+	if minimumOSVersion == "<nil>" {
+		return ""
+	}
+
+	return minimumOSVersion
