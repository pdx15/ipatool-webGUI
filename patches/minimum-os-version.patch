+// minimumOSVersion returns the minimum allowed OS version the installer
+// declares, so the version history can badge Mac builds like iOS ones.
+func (info macPreflightDistributionInfo) minimumOSVersion() string {
+	for _, version := range info.VolumeCheck.AllowedOSVersions.Versions {
+		if minimum := strings.TrimSpace(version.Min); minimum != "" {
+			return minimum
+		}
+	}
+
+	return ""
 }
 
