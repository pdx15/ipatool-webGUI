+func readMinimumOSVersionFromInfoPlist(metadata map[string]interface{}) string {
+	var minOS string
+	for _, key := range infoPlistMinimumOSVersionKeys {
+		value, ok := metadata[key]
+		if !ok || value == nil {
+			continue
+		}
+
+		candidate := strings.TrimSpace(fmt.Sprintf("%v", value))
+		if candidate == "" || candidate == "<nil>" {
+			continue
+		}
+
+		minOS = candidate
+		break
+	}
+
+	osPrefix := readSupportedOSPrefixFromInfoPlist(metadata)
+	if minOS == "" {
+		return osPrefix
+	}
+	if osPrefix != "" {
+		return osPrefix + " " + minOS
+	}
+
+	return minOS
+}
+
+func readSupportedOSPrefixFromInfoPlist(metadata map[string]interface{}) string {
+	raw, ok := metadata["CFBundleSupportedPlatforms"]
+	if !ok || raw == nil {
+		return ""
+	}
+
+	var platforms []string
+	switch v := raw.(type) {
+	case []string:
+		platforms = v
+	case []interface{}:
+		for _, item := range v {
+			if item != nil {
+				platforms = append(platforms, strings.TrimSpace(fmt.Sprintf("%v", item)))
+			}
+		}
+	}
+
+	for _, p := range platforms {
+		switch strings.ToLower(p) {
+		case "appletvos":
+			return "tvOS"
+		case "watchos":
+			return "watchOS"
+		case "xros":
+			return "visionOS"
+		case "macosx":
+			return "macOS"
+		case "iphoneos":
+			if isIPadOnlyDeviceFamily(metadata["UIDeviceFamily"]) {
+				return "iPadOS"
+			}
+			return "iOS"
+		}
+	}
+
+	return ""
+}
+
+func isIPadOnlyDeviceFamily(raw interface{}) bool {
+	if raw == nil {
+		return false
+	}
+
+	var hasIPhone, hasIPad bool
+	checkItem := func(item interface{}) {
+		switch strings.TrimSpace(fmt.Sprintf("%v", item)) {
+		case "1":
+			hasIPhone = true
+		case "2":
+			hasIPad = true
+		}
+	}
+
+	switch v := raw.(type) {
+	case []int:
+		for _, item := range v {
+			checkItem(item)
+		}
+	case []uint64:
+		for _, item := range v {
+			checkItem(item)
+		}
+	case []interface{}:
+		for _, item := range v {
+			checkItem(item)
+		}
+	}
+
+	return hasIPad && !hasIPhone
+}
